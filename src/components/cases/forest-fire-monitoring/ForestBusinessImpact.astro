---
/** Forest Fire Monitoring — Section 05: Business Impact */
const impacts = [
  { title: 'Market Creation', icon: 'forest', description: 'Identified an underserved market opportunity and helped establish a new commercial offering for the forestry sector.' },
  { title: 'Investment Recovery & Profitability', icon: 'growth', description: 'The business recovered its initial investment and became profitable during my management.', featured: true },
  { title: 'Recurring Revenue & Expansion', icon: 'handshake', description: 'Long-term service contracts generated recurring revenue and supported expansion across multiple corporate customers.' },
];
---
<section class="business-impact" aria-labelledby="business-impact-title">
  <header class="impact-heading">
    <p class="eyebrow"><b class="section-index">05</b><span>BUSINESS IMPACT</span></p>
    <h2 id="business-impact-title">From Opportunity to Profitable Business</h2>
    <p class="lead">What began as an opportunity identified during a technical visit evolved into a profitable, recurring-revenue business.</p>
    <p class="support">During my management, Aton recovered its initial investment, achieved profitability and expanded its customer base.</p>
  </header>
  <div class="impact-cards">
    {impacts.map((impact) => (
      <article class:list={['impact-card', { featured: impact.featured }]}>
        <span class="impact-icon" aria-hidden="true">
          {impact.icon === 'forest' ? (
            <svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M8 5 2.5 14h3L1 21h14l-4.5-7h3L8 5Z"/><path d="M8 21v6M23 3l-5.5 9h3L16 20h14l-4.5-8h3L23 3Z"/><path d="M23 20v8"/><path d="M4 28h24"/></svg>
          ) : impact.icon === 'growth' ? (
            <svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M3 28h26"/><path d="M6 25v-7h5v7M14 25V13h5v12M22 25V8h5v17"/><path d="m5 14 8-6 6 3 9-8"/><path d="M22 3h6v6"/></svg>
          ) : (
            <svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M7 4h14l5 5v18H7z"/><path d="M21 4v6h5M11 14h11M11 19h7"/><circle cx="23" cy="23" r="6" fill="#f6faff"/><path d="m20 23 2 2 4-4"/></svg>
          )}
        </span>
        <h3>{impact.title}</h3>
        <p>{impact.description}</p>
      </article>
    ))}
  </div>
  <div class="takeaway">
    <span class="takeaway-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="13" r="8"/><circle cx="11" cy="13" r="4.5"/><circle cx="11" cy="13" r="1.2"/><path d="m12 12 9-9m-4 0h4v4"/></svg></span>
    <div><strong>KEY TAKEAWAY</strong><p>Turning technical expertise and market insight into a financially sustainable business.</p></div>
  </div>
</section>
<style>
  .business-impact{height:100%;box-sizing:border-box;padding:clamp(1rem,2vw,1.5rem);background:#fff;border:1px solid #d8e5ec;border-radius:18px;color:#163d61;display:flex;flex-direction:column;gap:1.15rem}
  .eyebrow{display:flex;align-items:center;gap:.85rem;margin:0 0 .7rem;color:#315c78;font-size:.8rem;font-weight:800;letter-spacing:.12em;line-height:1.2}
  .section-index{font-size:2rem;line-height:1;color:#163d61;letter-spacing:0}
  h2{font-size:clamp(1.85rem,2.6vw,2.7rem);line-height:1.15;letter-spacing:-.025em;margin:0 0 .9rem;color:#102d49}
  .lead,.support{font-size:1rem;line-height:1.55;color:#4a6073;margin:0 0 .45rem}
  .impact-cards{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:.65rem;flex:1}
  .impact-card{border:1px solid #d8e5ec;border-radius:14px;background:#f6faff;padding:1rem .8rem;min-width:0}
  .impact-card.featured{background:#eaf7ef;border-color:#c8e9d7}
  .impact-icon{display:grid;place-items:center;width:46px;height:46px;border-radius:50%;background:#dceefb;color:#164d77;font-size:1.5rem;font-weight:800;margin-bottom:.8rem}
  .impact-icon svg,.takeaway-icon svg{width:26px;height:26px;display:block}
  .featured .impact-icon{background:#d2eee1}
  h3{font-size:clamp(.98rem,1.3vw,1.15rem);line-height:1.25;margin:0 0 .6rem;color:#163d61}
  .impact-card p{font-size:.87rem;line-height:1.48;color:#42627d;margin:0}
  .takeaway{display:flex;gap:.8rem;align-items:center;background:#eaf3fc;border-radius:12px;padding:1rem}
  .takeaway-icon{display:grid;place-items:center;width:46px;height:46px;border:1px solid #a8cdea;border-radius:50%;font-size:2rem;flex-shrink:0}
  .takeaway-icon svg{width:28px;height:28px}
  .takeaway strong{font-size:.73rem;letter-spacing:.1em}
  .takeaway p{font-size:.95rem;line-height:1.35;font-weight:700;margin:.25rem 0 0}
  @media(max-width:1150px){.impact-cards{grid-template-columns:1fr}.impact-card{display:grid;grid-template-columns:46px 1fr;column-gap:.8rem;align-items:start}.impact-icon{grid-row:span 2;margin:0}.impact-card h3{margin:0 0 .3rem}}
  @media(max-width:700px){.business-impact{padding:1rem}.section-index{font-size:1.65rem}.eyebrow{font-size:.72rem}h2{font-size:clamp(1.75rem,5vw,2.3rem)}}
</style>

<style>
  /* v3: unified line-art icon treatment. */
  .impact-icon { width: 52px; height: 52px; background:#e1f0fa; color:#15517a; }
  .impact-icon svg { width: 32px; height: 32px; }
  .featured .impact-icon { background:#d6f0e4; color:#155f60; }
  .takeaway-icon svg { width: 30px; height: 30px; }
  @media(max-width:1150px) { .impact-card { grid-template-columns:52px 1fr; } }
</style>
