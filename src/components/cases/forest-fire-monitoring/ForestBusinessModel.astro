---
// Section 03 — Business Model & Commercial Development
// The financial illustration is conceptual, NOT a historical cash-flow record.
const steps = [
  { title: 'Market identification', text: 'Recognized an opportunity to apply existing engineering capabilities to forestry operations.' },
  { title: 'Value proposition', text: 'Combined remote monitoring benefits with a long-term service proposition.' },
  { title: 'Customer engagement', text: 'Presented the concept and engaged directly with prospective forestry customers.' },
  { title: 'First contract', text: 'Converted the concept into its first commercial implementation.' },
  { title: 'Market expansion', text: 'Built on the initial reference to reach additional forestry operators.' },
];
const model = [
  { heading: 'INFRASTRUCTURE', items: ['Monitoring equipment', 'Radio infrastructure', 'System development'] },
  { heading: 'RECURRING SERVICE', items: ['Long-term rental agreements', 'Monthly service payments', 'Support and maintenance'] },
  { heading: 'CUSTOMER VALUE', items: ['Lower upfront investment', 'Continuous monitoring', 'Less technical complexity'] },
];
// Projected scenario supplied for the case-study illustration (months 1–30).
// Used only to define chart geometry. Monetary values are intentionally hidden.
const receipts = [0, 0, 257384.62, 257384.62, 832230.77, 525230.77, ...Array(24).fill(262230.77)];
const payments = [150000, 395130.77, 628976.92, 890015.38, 402400, 600000,
  500000, 400000, 300000, 270000, 200000, 40000, 45000, 60000, 35000,
  30000, 70000, 40000, 50000, 50000, 52000, 35000, 36000, 70000,
  24000, 35400, 35400, 45000, 60000, 35000];
let runningTotal = 0;
const flows = receipts.map((receipt, i) => {
  const net = receipt - payments[i];
  runningTotal += net;
  return { month: i + 1, net, cumulative: runningTotal };
});
// Single shared scale for monthly bars and cumulative line.
const plot = { left: 26, right: 443, top: 22, bottom: 197 };
const x = (month: number) => plot.left + month / 30 * (plot.right - plot.left);
const y = (value: number) => plot.bottom - (value + 1850000) / 4700000 * (plot.bottom - plot.top);
const zeroY = y(0);
const cumulativePath = flows.map((p, i) => `${i === 0 ? 'M' : 'L'} ${x(p.month).toFixed(2)} ${y(p.cumulative).toFixed(2)}`).join(' ');
const gridValues = [-1500000, -1000000, -500000, 0, 500000, 1000000, 1500000, 2000000, 2500000];
const xTicks = [0, 6, 12, 18, 24, 30];
const icons = [
  'search', 'idea', 'people', 'contract', 'growth'
];
---
<section class="fbm" aria-labelledby="fbm-title">
  <div class="fbm__container">
    <header class="fbm__intro">
      <p class="fbm__eyebrow"><b class="section-index">03</b> <span>BUSINESS MODEL &amp; COMMERCIAL DEVELOPMENT</span></p>
      <h2 id="fbm-title">From solution to business</h2>
      <p class="fbm__subtitle">Creating a recurring-revenue model for forest monitoring.</p>
      <p class="fbm__summary">A long-term service model combined infrastructure investment, customer deployment fees and recurring rental payments.</p>
    </header>

    <div class="fbm__grid">
      <div class="fbm__left-stack">
      <article class="fbm__panel">
        <div class="fbm__panel-title"><span class="fbm__number">01</span><div><h3>Business Model</h3><p>A different commercial approach</p></div></div>
        <p class="fbm__panel-lead">The provider financed monitoring assets; customers paid deployment fees and recurring rental and support charges.</p>
        <div class="fbm__flow" aria-label="Service provider finances infrastructure, offers long-term rental service and delivers monitoring capability to the customer">
          <div class="fbm__flow-node"><span class="fbm__icon fbm__icon--blue" aria-hidden="true"><svg viewBox="0 0 32 32"><path d="M7 27V7h18v20M12 7V4h8v3M11 12h3m4 0h3m-10 5h3m4 0h3m-10 5h3m4 0h3M4 27h24"/></svg></span><strong>SERVICE PROVIDER</strong><small>Finances infrastructure</small></div>
          <span class="fbm__arrow" aria-hidden="true">→</span>
          <div class="fbm__flow-node"><span class="fbm__icon fbm__icon--green" aria-hidden="true"><svg viewBox="0 0 32 32"><path d="m16 7-8 20h16L16 7Zm-5 12h10M16 7v20M10 4a9 9 0 0 0-4 7m16-7a9 9 0 0 1 4 7M7 1a14 14 0 0 0-6 12m24-12a14 14 0 0 1 6 12"/></svg></span><strong>SERVICE</strong><small>Long-term rental</small></div>
          <span class="fbm__arrow" aria-hidden="true">→</span>
          <div class="fbm__flow-node"><span class="fbm__icon fbm__icon--sky" aria-hidden="true"><svg viewBox="0 0 32 32"><circle cx="16" cy="10" r="4"/><circle cx="6" cy="14" r="3"/><circle cx="26" cy="14" r="3"/><path d="M8 27v-5a8 8 0 0 1 16 0v5H8ZM2 27v-5a5 5 0 0 1 5-5m23 10v-5a5 5 0 0 0-5-5"/></svg></span><strong>CUSTOMER</strong><small>Monitoring capability</small></div>
        </div>
        <div class="fbm__model-cols">
          {model.map((col) => <div class="fbm__model-col"><h4>{col.heading}</h4><ul>{col.items.map((item) => <li>{item}</li>)}</ul></div>)}
        </div>
        <div class="fbm__metrics"><div><strong>36+ months</strong><span>Initial contract terms</span></div><div><strong>18–24 months</strong><span>Projected payback</span></div><div><strong>Recurring</strong><span>Service revenue</span></div></div>
      </article>

      <article class="fbm__panel">
        <div class="fbm__panel-title"><span class="fbm__number fbm__number--green">02</span><div><h3>Commercial Development</h3><p>Creating demand and expanding the market</p></div></div>
        <p class="fbm__panel-lead">The opportunity required technical development and a commercial approach that customers could adopt.</p>
        <ol class="fbm__timeline">{steps.map((step, index) => <li>
          <span class="fbm__step-number">{index + 1}</span>
          <span class="fbm__step-icon" aria-hidden="true">
            {icons[index] === 'search' && <svg viewBox="0 0 24 24"><circle cx="10" cy="10" r="6"/><path d="m14.5 14.5 5.5 5.5"/></svg>}
            {icons[index] === 'idea' && <svg viewBox="0 0 24 24"><path d="M9 18h6m-5 3h4M8 15c-1.4-1.1-2.2-2.7-2.2-4.5a6.2 6.2 0 0 1 12.4 0c0 1.8-.8 3.4-2.2 4.5-.7.6-1 1.2-1 2H9c0-.8-.3-1.4-1-2Z"/></svg>}
            {icons[index] === 'people' && <svg viewBox="0 0 24 24"><circle cx="12" cy="7" r="3"/><path d="M5 20v-2a7 7 0 0 1 14 0v2H5ZM4 8a2 2 0 1 0 0 4m16-4a2 2 0 1 1 0 4"/></svg>}
            {icons[index] === 'contract' && <svg viewBox="0 0 24 24"><path d="M6 2h9l4 4v16H6zM15 2v5h4M9 12h7M9 16h5"/><path d="m14 19 2 2 4-4"/></svg>}
            {icons[index] === 'growth' && <svg viewBox="0 0 24 24"><path d="M3 20h18M6 18v-5h3v5m3 0V9h3v9m3 0V5h3v13M4 11l7-5 4 2 5-5"/></svg>}
          </span>
          <div><h4>{step.title}</h4><p>{step.text}</p></div>
        </li>)}</ol>
      </article>

      </div><!-- /.fbm__left-stack -->
      <article class="fbm__panel fbm__panel--economics">
        <div class="fbm__panel-title"><span class="fbm__number">03</span><div><h3>Business Economics</h3><p>Making the model sustainable</p></div></div>
        <p class="fbm__panel-lead">Recurring service revenue was designed to recover the upfront infrastructure investment.</p>
        <figure class="fbm__chart">
          <figcaption><strong>Illustrative financial model</strong><span>Projected scenario — not actual financial results</span></figcaption>
          <div class="fbm__chart-legend" aria-hidden="true"><span><i class="fbm__legend-line"></i>Cumulative cash flow</span><span><i class="fbm__legend-positive"></i>Positive monthly net cash flow</span><span><i class="fbm__legend-negative"></i>Negative monthly net cash flow</span></div>
          <svg viewBox="0 0 460 230" role="img" aria-labelledby="fbm-chart-title fbm-chart-desc" preserveAspectRatio="xMidYMid meet">
            <title id="fbm-chart-title">Projected cash-flow illustration over 30 months</title>
            <desc id="fbm-chart-desc">One shared scale: coral bars show negative monthly net cash flow, blue bars positive monthly net cash flow, and a dark blue line shows cumulative cash flow. The cumulative balance is initially negative, reaches its low point during investment, and crosses zero within the highlighted projected payback window of months 18 to 24. No monetary amounts or calendar dates are displayed.</desc>
            <rect x={x(18)} y={plot.top} width={x(24)-x(18)} height={plot.bottom-plot.top} fill="#d9efe6" opacity=".8" />
            {gridValues.map(v => <line x1={plot.left} x2={plot.right} y1={y(v)} y2={y(v)} stroke={v === 0 ? '#597082' : '#dbe4eb'} stroke-width={v === 0 ? '1.2' : '.7'} />)}
            <text x="19" y={zeroY+3} text-anchor="end" font-size="9" fill="#52687b">0</text>
            {flows.map(p => {
              const barWidth = 9;
              const barY = Math.min(zeroY, y(p.net));
              const barHeight = Math.abs(zeroY - y(p.net));
              return <rect x={x(p.month)-barWidth/2} y={barY} width={barWidth} height={Math.max(barHeight, .7)} fill={p.net < 0 ? '#d77868' : '#7eb5e3'} />;
            })}
            <path d={cumulativePath} fill="none" stroke="#194b75" stroke-width="2.7" stroke-linecap="round" stroke-linejoin="round" />
            <text x={x(5.2)} y={y(1000000)} text-anchor="middle" font-size="9" fill="#52687b">Initial investment phase</text>
            <text x={x(21)} y={y(-800000)} text-anchor="middle" font-size="9.2" font-weight="700" fill="#194b75">Projected payback window</text>
            {xTicks.map(t => <g><line x1={x(t)} x2={x(t)} y1={plot.bottom} y2={plot.bottom+3} stroke="#8297a8" /><text x={x(t)} y={plot.bottom+15} text-anchor="middle" font-size="9" fill="#52687b">{t}</text></g>)}
            <line x1={plot.left} x2={plot.right} y1={plot.bottom} y2={plot.bottom} stroke="#9eafbc" stroke-width=".9" />
            <text x={(plot.left+plot.right)/2} y="225" text-anchor="middle" font-size="10" fill="#52687b">Months</text>
          </svg>
          <p class="fbm__chart-note">Illustrative financial model based on projected cash flows. Not actual financial results. Monetary values and calendar dates are intentionally hidden.</p>
        </figure>
        <div class="fbm__takeaways"><h4>Key takeaways</h4><ul><li>Infrastructure investment supported long-term contracts.</li><li>Monthly payments created a recurring revenue stream.</li><li>The model supported expansion across additional customers and forest areas.</li></ul></div>
      </article>
    </div>
    <div class="fbm__closing"><span aria-hidden="true">↗</span><p>Engineering expertise and customer relationships turned a technical solution into a repeatable, recurring-revenue service.</p></div>
  </div>
</section>
<style>
  .fbm{padding:clamp(3rem,6vw,6rem) 1.25rem;background:#f7fafc;color:#153e69;font-family:inherit}
  .fbm__container{max-width:1500px;margin:0 auto}.fbm__intro{margin:0 0 1.5rem}.fbm__eyebrow{font-size:.83rem;letter-spacing:.09em;font-weight:800;color:#16846d;margin:0 0 .5rem}.fbm__eyebrow span{color:#153e69}.fbm__eyebrow .section-index{color:#153e69}.fbm h2{font-size:clamp(2rem,3.5vw,3.25rem);line-height:1.1;letter-spacing:-.035em;margin:.2rem 0}.fbm__subtitle{font-size:clamp(1.12rem,1.7vw,1.5rem);color:#506983;margin:.45rem 0}.fbm__summary{max-width:1100px;color:#506983;line-height:1.6;margin:.8rem 0 0}
  .fbm__grid{display:grid;grid-template-columns:1.08fr .94fr 1fr;gap:1rem;align-items:stretch}.fbm__panel{min-width:0;background:#fff;border:1px solid #dce8f0;border-radius:16px;padding:clamp(1rem,1.6vw,1.55rem);box-shadow:0 8px 30px rgba(24,66,99,.035)}
  .fbm__panel-title{display:flex;align-items:center;gap:.85rem}.fbm__number{flex:none;display:grid;place-items:center;width:48px;height:48px;border-radius:50%;background:#e0efff;color:#0c5799;font-weight:800;font-size:1.25rem}.fbm__number--green{background:#e0f1e9;color:#086a57}.fbm__panel h3{font-size:clamp(1.18rem,1.6vw,1.45rem);margin:0;line-height:1.15}.fbm__panel-title p{margin:.25rem 0 0;color:#58718b;font-size:.92rem}.fbm__panel-lead{line-height:1.55;color:#496681;font-size:.94rem;min-height:4.4rem;margin:1.15rem 0}
  .fbm__flow{display:flex;align-items:flex-start;justify-content:space-between;gap:.25rem;margin:1.25rem 0}.fbm__flow-node{flex:1;min-width:0;text-align:center;display:flex;align-items:center;flex-direction:column;gap:.35rem}.fbm__icon{width:62px;height:62px;border-radius:50%;display:grid;place-items:center;color:#fff;font-size:2rem;background:#17456f}.fbm__icon--green{background:#4da57e}.fbm__icon--sky{background:#5399df}.fbm__flow-node strong{font-size:.8rem}.fbm__flow-node small{font-size:.74rem;color:#56718a;line-height:1.3}.fbm__arrow{color:#8aa4b6;font-size:1.5rem;padding-top:1.1rem}
  .fbm__model-cols{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:.45rem}.fbm__model-col{background:#f0f6fb;padding:.8rem .55rem;border-radius:10px}.fbm__model-col:nth-child(2){background:#eaf6f0}.fbm__model-col h4{font-size:.71rem;line-height:1.25;margin:0 0 .55rem;color:#164a78}.fbm__model-col:nth-child(2) h4{color:#086a57}.fbm__model-col ul,.fbm__takeaways ul{list-style:none;padding:0;margin:0}.fbm__model-col li{font-size:.75rem;color:#496681;line-height:1.4;padding:.2rem 0 .2rem .85rem;position:relative}.fbm__model-col li:before,.fbm__takeaways li:before{content:'✓';position:absolute;left:0;color:#16846d;font-weight:800}
  .fbm__metrics{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:.45rem;margin-top:.75rem}.fbm__metrics div{background:#f0f6fb;border-radius:10px;text-align:center;padding:.8rem .4rem}.fbm__metrics div:nth-child(2){background:#eaf6f0}.fbm__metrics strong{display:block;font-size:clamp(.95rem,1.3vw,1.17rem);letter-spacing:-.02em;line-height:1.25}.fbm__metrics span{display:block;font-size:.73rem;color:#506983;margin-top:.4rem;line-height:1.35}
  .fbm__timeline{list-style:none;padding:0;margin:1.2rem 0 0;display:grid;gap:.65rem;counter-reset:stage}.fbm__timeline li{display:grid;grid-template-columns:30px 1fr;gap:.65rem;align-items:start}.fbm__step-number{width:30px;height:30px;display:grid;place-items:center;background:#147c83;color:white;border-radius:50%;font-weight:800;font-size:.8rem}.fbm__timeline li:nth-child(odd) .fbm__step-number{background:#145a9b}.fbm__timeline li>div{background:#f0f6fb;padding:.75rem .9rem;border-radius:10px}.fbm__timeline h4{margin:0 0 .25rem;font-size:.91rem}.fbm__timeline p{margin:0;font-size:.83rem;line-height:1.45;color:#506983}
  .fbm__chart{margin:1rem 0 .75rem;border-radius:12px;overflow:hidden;border:1px solid #e1eaf0}.fbm__chart figcaption{background:#edf4fa;padding:.8rem .9rem;display:flex;flex-direction:column;gap:.2rem}.fbm__chart figcaption strong{font-size:.85rem}.fbm__chart figcaption span{font-size:.72rem;color:#526d83}.fbm__chart svg{width:100%;height:auto;display:block;background:#fff}.fbm__chart-note{font-size:.7rem;color:#5d7181;line-height:1.4;padding:0 .8rem .75rem;margin:0}.fbm__takeaways{background:#f0f6fb;border-radius:12px;padding:.9rem 1rem}.fbm__takeaways h4{margin:0 0 .55rem;font-size:.9rem}.fbm__takeaways li{position:relative;padding:.25rem 0 .25rem 1.15rem;color:#496681;font-size:.81rem;line-height:1.45}
  .fbm__closing{display:flex;gap:.8rem;align-items:center;border:1px solid #cde4db;background:#f0f8f5;border-radius:12px;margin-top:1rem;padding:1rem 1.25rem}.fbm__closing span{flex:none;display:grid;place-items:center;border-radius:50%;background:#75b59a;color:white;width:34px;height:34px;font-size:1.4rem}.fbm__closing p{font-weight:700;font-size:.95rem;margin:0;line-height:1.5}
  @media(max-width:1180px){.fbm__grid{grid-template-columns:1fr 1fr}.fbm__panel:last-child{grid-column:1/-1}.fbm__panel-lead{min-height:0}.fbm__chart{max-width:650px}}
  @media(max-width:700px){.fbm{padding:3rem 1rem}.fbm__grid{grid-template-columns:1fr}.fbm__panel:last-child{grid-column:auto}.fbm__panel{padding:1rem}.fbm__model-cols{grid-template-columns:1fr 1fr 1fr}.fbm__model-col{padding:.65rem .4rem}.fbm__model-col h4{font-size:.65rem}.fbm__model-col li{font-size:.69rem}.fbm__flow-node small{font-size:.68rem}.fbm__icon{width:52px;height:52px}.fbm__closing{align-items:flex-start}}
  @media(max-width:390px){.fbm__model-cols{grid-template-columns:1fr}.fbm__metrics{grid-template-columns:1fr 1fr}.fbm__metrics div:last-child{grid-column:1/-1}}

/* Case-wide typography standard: sections 01–04 */
.fbm .fbm__eyebrow { display:flex; align-items:center; gap:.85rem; margin:0 0 .65rem; font-size:.8rem; font-weight:800; letter-spacing:.12em; line-height:1.2; text-transform:uppercase; }
