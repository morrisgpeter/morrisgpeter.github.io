---
/** Forest Fire Monitoring — Section 06. Compact timeline inspired by FibraTimeline. */
const events = [
  {
    year: '2007',
    name: 'IV South American Forest Fire Symposium',
    place: 'Brazil',
    image: '/images/forest-industry-recognition/event-2007.jpg',
    alt: 'Presenting the forest fire monitoring concept at the 2007 symposium.',
    caption: 'Introducing the forest fire monitoring concept to its target audience for the first time.',
  },
  {
    year: '2015',
    name: 'National Forest Fire Prevention & Control Seminar',
    place: 'Viçosa, Minas Gerais',
    image: '/images/forest-industry-recognition/event-2015.jpg',
    alt: 'Panel at the 2015 national forest fire prevention and control seminar.',
    caption: 'Continuing the technical conversation across the sector.',
  },
  {
    year: '2017',
    name: 'International Forest Fire Prevention & Control Seminar',
    place: 'Viçosa, Minas Gerais',
    image: null,
    alt: '',
    caption: 'Talk: Forest Fire Detection Technologies.',
  },
  {
    year: '2018',
    name: 'II Regional Forest Fire Prevention & Control Symposium',
    place: 'Petrópolis, Rio de Janeiro',
    image: '/images/forest-industry-recognition/event-2018.jpg',
    alt: 'Presentation on camera and other monitoring technologies at the 2018 symposium.',
    caption: 'Talk: Cameras and Other Technologies for Forest Fire Detection and Monitoring.',
  },
];
---
<section class="recognition" aria-labelledby="recognition-title">
  <header class="section-heading">
    <span class="section-index">06</span>
    <div>
      <p class="eyebrow">INDUSTRY RECOGNITION</p>
      <h2 id="recognition-title">Sharing Expertise Beyond Project Delivery</h2>
      <p class="intro">Technical expertise developed through forest fire monitoring projects continued to be shared at industry events, including presentations on fire detection technologies between 2007 and 2018.</p>
    </div>
  </header>

  <div class="timeline-panel">
    <ol class="timeline" aria-label="Industry events from 2007 to 2018">
      {events.map((event) => (
        <li class="event">
          <span class="dot" aria-hidden="true"></span>
          <time class="year">{event.year}</time>
          {event.image ? (
            <div class:list={["media", { "media-2007": event.year === "2007" }]}><img src={event.image} alt={event.alt} loading="lazy" /></div>
          ) : null}
          <h3>{event.name}</h3>
          <p class="place">{event.place}</p>
          <p class="caption">{event.caption}</p>
        </li>
      ))}
    </ol>
  </div>
  <p class="footnote">Events span roles at Aton Engenharia and Fibra Engenharia. The timeline highlights technical knowledge sharing rather than commercial delivery for either company.</p>
</section>

<style>
  .recognition{color:#18334c;padding:clamp(1.5rem,3vw,2.7rem) 0;max-width:1250px;margin:0 auto}
  .section-heading{display:flex;gap:1.3rem;align-items:flex-start;margin-bottom:1.25rem}
  .section-index{font-size:clamp(2.2rem,4vw,3.5rem);font-weight:750;color:#183b59;line-height:1}
  .eyebrow{font-size:.72rem;font-weight:750;letter-spacing:.15em;color:#2774a5;margin:0 0 .4rem}
  h2{font-size:clamp(1.55rem,2.6vw,2.35rem);line-height:1.2;margin:0 0 .55rem;color:#17344e}
  .intro{max-width:820px;line-height:1.55;color:#526b7c;margin:0;font-size:.92rem}
  .timeline-panel{background:linear-gradient(115deg,#fff 0%,#f5f9fd 100%);border:1px solid #e1eaf4;border-radius:16px;padding:1.15rem 1.25rem 1.3rem}
  .timeline{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));list-style:none;margin:0;padding:0 8px 0 3px;position:relative;gap:1rem}
  .timeline::before{content:"";position:absolute;top:7px;left:10px;right:11px;height:2px;background:#3184c6}
  .timeline::after{content:"";position:absolute;right:0;top:1px;border-top:7px solid transparent;border-bottom:7px solid transparent;border-left:11px solid #3184c6}
  .event{min-width:0;position:relative;padding-top:1.65rem}
  .dot{position:absolute;top:0;left:0;width:16px;height:16px;border:3px solid #e8f3fd;border-radius:50%;background:#1679bf;box-shadow:0 0 0 1px #1679bf}
  .year{display:block;font-size:.86rem;font-weight:800;color:#12365f;margin-bottom:.5rem}
  .media{height:96px;border-radius:8px;overflow:hidden;background:#eaf1f5;margin-bottom:.65rem}
  .media img{width:100%;height:100%;object-fit:cover;object-position:center;display:block}
  /* Keep the presenter's face in view in the wide 2007 thumbnail. */
  .media-2007 img{object-position:75% 8%}
  h3{font-size:.83rem;line-height:1.35;color:#153e69;margin:0 0 .35rem}
  .place{font-size:.74rem;color:#718493;margin:0 0 .4rem}
  .caption{font-size:.76rem;line-height:1.48;color:#52677e;margin:0}
  .footnote{font-size:.75rem;line-height:1.55;color:#718493;margin:.75rem 0 0}
  @media(max-width:760px){
    .section-heading{gap:.8rem}
    .timeline-panel{padding:1.1rem 1rem}
    .timeline{display:block;padding:0 0 0 .4rem}
    .timeline::before,.timeline::after{display:none}
    .event{border-left:2px solid #bdd7ec;margin-left:.4rem;padding:.05rem 0 1.25rem 1.15rem}
    .dot{top:2px;left:-9px}
    .year{margin-bottom:.4rem}
    .media{height:125px;max-width:270px}
    .event:last-child{padding-bottom:.25rem}
    .event:last-child::after{content:"";position:absolute;left:-6px;bottom:-11px;border-left:5px solid transparent;border-right:5px solid transparent;border-top:10px solid #3184c6}
  }
  @media(max-width:420px){.section-index{font-size:2rem}.media{height:110px}}
</style>
