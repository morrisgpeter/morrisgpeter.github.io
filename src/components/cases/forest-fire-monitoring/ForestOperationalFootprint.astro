          <circle cx="189.66" cy="145.78" r="2.9" class="pin-core" />
        </g>
        <g class="pin" tabindex="0" role="img" aria-label="Gerdau — Brasilandia de Minas, Minas Gerais" style="--pin-color: #ed9a49">
