          <circle cx="181.12" cy="145.69" r="2.9" class="pin-core" />
        </g>
        <g class="pin" tabindex="0" role="img" aria-label="ArcelorMittal — Francisco Sá, Minas Gerais" style="--pin-color: #df6b6b">
          <title>ArcelorMittal — Francisco Sá, Minas Gerais</title>
          <circle cx="186.49" cy="132.69" r="4.8" class="pin-halo" />
          <circle cx="186.49" cy="132.69" r="2.9" class="pin-core" />
        </g>
        <g class="pin" tabindex="0" role="img" aria-label="ArcelorMittal — Guanhães, Minas Gerais" style="--pin-color: #df6b6b">
