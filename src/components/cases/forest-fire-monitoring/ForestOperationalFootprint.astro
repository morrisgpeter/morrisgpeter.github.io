          <circle cx="172.08" cy="135.79" r="2.9" class="pin-core" />
        </g>
        <g class="pin" tabindex="0" role="img" aria-label="Gerdau — João Pinheiro, Minas Gerais" style="--pin-color: #ed9a49">
          <title>Gerdau — João Pinheiro, Minas Gerais</title>
