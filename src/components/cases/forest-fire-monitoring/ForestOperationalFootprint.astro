          <title>Gerdau — Montes Claros, Minas Gerais</title>
          <circle cx="184.34" cy="134.18" r="4.8" class="pin-halo" />
          <circle cx="184.34" cy="134.18" r="2.9" class="pin-core" />
        </g>
        <g class="pin" tabindex="0" role="img" aria-label="Gerdau — Rio Pardo de Minas, Minas Gerais" style="--pin-color: #ed9a49">
          <title>Gerdau — Rio Pardo de Minas, Minas Gerais</title>
          <circle cx="191.92" cy="127.73" r="4.8" class="pin-halo" />
          <circle cx="191.92" cy="127.73" r="2.9" class="pin-core" />
        </g>
        <g class="pin" tabindex="0" role="img" aria-label="Gerdau — Três Marias, Minas Gerais" style="--pin-color: #ed9a49">
          <title>Gerdau — Três Marias, Minas Gerais</title>
          <circle cx="176.54" cy="142.55" r="4.8" class="pin-halo" />
          <circle cx="176.54" cy="142.55" r="2.9" class="pin-core" />
        </g>
        <g class="pin" tabindex="0" role="img" aria-label="Saint-Gobain — Bom Jardim de Minas, Minas Gerais" style="--pin-color: #4b92df">
          <title>Saint-Gobain — Bom Jardim de Minas, Minas Gerais</title>
          <circle cx="182.48" cy="163.88" r="4.8" class="pin-halo" />
          <circle cx="182.48" cy="163.88" r="2.9" class="pin-core" />
        </g>
        <g class="pin" tabindex="0" role="img" aria-label="WestRock — Três Barras, Santa Catarina" style="--pin-color: #48b99d">
