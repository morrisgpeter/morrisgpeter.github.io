  { company: 'ArcelorMittal', city: 'Francisco Sá', state: 'Minas Gerais', lat: -16.47583, lon: -43.48833 },
  { company: 'ArcelorMittal', city: 'Guanhães', state: 'Minas Gerais', lat: -18.7710002, lon: -42.9318885 },
  { company: 'Gerdau', city: 'Brasilandia de Minas', state: 'Minas Gerais', lat: -17.0194, lon: -46.0152 },
  { company: 'Gerdau', city: 'João Pinheiro', state: 'Minas Gerais', lat: -17.7458, lon: -46.1788 },
  { company: 'Gerdau', city: 'Montes Claros', state: 'Minas Gerais', lat: -16.7368647, lon: -43.8652467 },
  { company: 'Gerdau', city: 'Rio Pardo de Minas', state: 'Minas Gerais', lat: -15.60556, lon: -42.53417 },
  { company: 'Gerdau', city: 'Três Marias', state: 'Minas Gerais', lat: -18.205, lon: -45.2326 },
  { company: 'Saint-Gobain', city: 'Bom Jardim de Minas', state: 'Minas Gerais', lat: -21.94722, lon: -44.19111 },
