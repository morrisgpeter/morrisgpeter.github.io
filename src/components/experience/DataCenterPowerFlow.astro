---
// Conceptual power-flow illustration; intentionally not a single-line electrical diagram.
const stages = [
  {
    title: 'Utility Supply',
    description: 'Electrical power supplied by the utility network.',
    image: '/images/experience/datacenter-utility.webp',
    alt: 'Isometric illustration of a utility substation with overhead lines and a transformer.',
  },
  {
    title: 'Medium-Voltage UPS (MV UPS)',
    description: 'Supports power continuity and protects critical operations from supply disturbances.',
    image: '/images/experience/datacenter-ups.webp',
    alt: 'Isometric illustration of industrial medium-voltage UPS equipment cabinets.',
  },
  {
    title: 'Data Center Loads',
    description: 'IT equipment and supporting infrastructure requiring reliable power.',
    image: '/images/experience/datacenter-datacenter.webp',
    alt: 'Isometric cutaway illustration of a data center with rows of server racks.',
  },
];
---
<section class="power-flow" aria-labelledby="dc-flow-heading">
  <div class="flow-heading">
    <h3 id="dc-flow-heading">Medium-Voltage UPS in Data Center Infrastructure</h3>
    <p>A simplified view of how medium-voltage UPS systems support reliable power for hyperscale data centers and other mission-critical infrastructure.</p>
  </div>

  <!-- Wide artwork is decorative because each stage is described in the accessible list below. -->
  <img
    class="wide-artwork"
    src="/images/experience/datacenter-power-flow-wide.webp"
    alt=""
    aria-hidden="true"
    loading="lazy"
    decoding="async"
    width="1947"
    height="364"
  />

  <ol class="flow-stages" aria-label="Conceptual power flow from utility supply to data center loads">
    {stages.map((stage, index) => (
      <li class="flow-stage">
        <img class="mobile-artwork" src={stage.image} alt={stage.alt} loading="lazy" decoding="async" />
        <div class="stage-info">
          <span class="stage-number" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
          <div>
            <h4>{stage.title}</h4>
            <p>{stage.description}</p>
          </div>
        </div>
      </li>
    ))}
  </ol>

  <p class="flow-note">Conceptual illustration only. Actual electrical system topology and equipment configuration vary by installation. Intermediate switchgear, transformers, battery energy storage systems, and distribution equipment are not shown.</p>
</section>

<style>
  .power-flow{color:#17385e;margin-block:1.5rem 2rem;max-width:100%;min-width:0}
  .flow-heading h3{font-size:clamp(1.3rem,2.1vw,1.85rem);line-height:1.2;letter-spacing:-.025em;color:#123b6b;margin:0 0 .5rem;font-weight:750}
  .flow-heading p{font-size:clamp(.9rem,1.3vw,1rem);line-height:1.6;color:#5b718b;margin:0;max-width:75ch}
  .wide-artwork{display:block;width:100%;height:auto;margin:1.2rem auto .55rem;object-fit:contain}
  .flow-stages{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:1rem;margin:0;padding:0;list-style:none}
  .flow-stage{min-width:0;border:1px solid #deebf7;border-radius:16px;background:#f4f8fd;padding:1rem 1.05rem}
  .stage-info{display:flex;align-items:flex-start;gap:.75rem}
  .stage-number{flex:none;display:grid;place-items:center;width:2.25rem;height:2.25rem;border-radius:10px;background:#e2effb;color:#236cad;font-size:.85rem;font-weight:750}
  .flow-stage h4{margin:.08rem 0 .35rem;color:#153e6d;font-size:clamp(.86rem,1.2vw,1rem);line-height:1.3;font-weight:750}
  .flow-stage p{margin:0;color:#5a708a;font-size:.83rem;line-height:1.5}
  .mobile-artwork{display:none}
  .flow-note{margin:1rem 0 0;color:#6b7d91;font-size:.76rem;line-height:1.55}
  @media(max-width:700px){
    .wide-artwork{display:none}
    .flow-stages{grid-template-columns:1fr;gap:.85rem;margin-top:1.1rem}
    .flow-stage{padding:.75rem .9rem 1rem}
    .mobile-artwork{display:block;width:100%;max-width:420px;height:auto;margin:0 auto .35rem}
    .stage-info{gap:.7rem}
    .flow-stage h4{font-size:1rem}
    .flow-stage p{font-size:.86rem}
    .flow-note{font-size:.75rem}
  }
</style>
