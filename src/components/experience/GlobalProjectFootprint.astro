r-core,.gpf-marker:focus-visible .gpf-marker-core,.gpf-marker.is-selected .gpf-marker-core{outline:3px solid #83b9ef;outline-offset:2px}.gpf-projects{--marker:#2878c6}.gpf-manufacturing{--marker:#249779}.gpf-suppliers{--marker:#dc8b36}.gpf-demonstrations{--marker:#8c63bb}.gpf-marker[hidden]{display:none}.gpf-legend{position:static;width:190px;padding:.85rem;background:#fffffff0;border:1px solid #dce8f5;border-radius:11px;box-shadow:0 2px 12px #214d7310;font-size:.7rem}.gpf-legend strong{display:block;font-size:.72rem;margin-bottom:.5rem}.gpf-scale{display:flex;align-items:center;gap:.65rem;min-height:39px}.gpf-scale-dot{width:var(--sample);height:var(--sample);flex:none;border-radius:50%;background:#2878c6;border:2px solid #fff;box-shadow:0 0 0 1px #2878c6}.gpf-legend small{display:block;color:#5e7791;line-height:1.35;margin:.45rem 0}.gpf-legend-rule{height:1px;background:#dce8f5;margin:.65rem 0}.gpf-legend-item{display:flex;align-items:center;gap:.55rem;margin:.5rem 0}.gpf-note{font-size:.75rem;line-height:1.6;color:#6d8093;margin:1rem 0 0}.gpf button:focus-visible{outline:3px solid #1e78c6;outline-offset:3px}
@media(max-width:960px){.gpf-legend{display:grid!important;grid-template-columns:repeat(2,minmax(0,1fr));align-items:center;column-gap:.85rem;row-gap:.4rem}.gpf-legend strong,.gpf-legend small{grid-column:1/-1}.gpf-legend .gpf-scale{min-width:0;gap:.4rem}.gpf-legend .gpf-legend-item{grid-column:1/-1;margin:.1rem 0}.gpf-map-wrap{grid-template-columns:1fr}.gpf-legend{position:static;width:auto;display:flex;flex-wrap:wrap;align-items:center;gap:.55rem 1rem;margin-top:.65rem}.gpf-legend strong{width:100%;margin:0}.gpf-scale{min-height:30px}.gpf-scale-dot{transform:scale(.65);margin:-7px}.gpf-legend-rule{display:none}.gpf-legend small{width:100%}}
@media(max-width:760px){.gpf{padding:1rem}.gpf-header{display:block}.gpf-kicker{display:block;margin-top:.7rem}.gpf-bottom{grid-template-columns:1fr}.gpf-filter{font-size:.74rem;padding:.5rem .65rem}.gpf-map{aspect-ratio:1200/570}.gpf-bubble .gpf-marker-core{width:clamp(14px,calc(var(--size)*.72),38px);height:clamp(14px,calc(var(--size)*.72),38px);font-size:10px}}
@media(max-width:480px){.gpf-map{aspect-ratio:1200/570;min-height:220px}.gpf-marker{width:22px;height:22px}.gpf-bubble .gpf-marker-core{width:clamp(12px,calc(var(--size)*.55),28px);height:clamp(12px,calc(var(--size)*.55),28px);font-size:9px}.gpf-legend{font-size:.67rem}.gpf-table{font-size:.7rem}.gpf-table td,.gpf-table th{padding:.42rem .32rem}}
</style>

<style>
