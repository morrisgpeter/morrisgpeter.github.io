@media(max-width:600px){.gpf-regions{gap:.35rem}.gpf-region{padding:.6rem .4rem;gap:.3rem;flex-direction:column;text-align:center}.gpf-region strong{font-size:.68rem}.gpf-region small{font-size:.61rem}}
