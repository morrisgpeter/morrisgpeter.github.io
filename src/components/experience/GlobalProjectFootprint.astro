    <div class="gpf-map" role="group" aria-label="Interactive regional map; select a marker to identify its location">
      {regions.map((r,i)=><img class="gpf-map-image" src={`/images/experience/footprint-${r.id}.svg`} alt="" width="1200" height="570" loading={i===0?'eager':'lazy'} data-region-image={r.id} hidden={i!==0}/>)}
      {markers.map(item=><button type="button" class:list={['gpf-marker',`gpf-${item.category}`,{'gpf-bubble':item.category==='projects'}]} style={`left:${item.x}%;top:${item.y}%;--size:${item.diameter}px;`} data-index={item.index} data-category={item.category} data-region={item.region} aria-label={`${item.city}, ${item.country}, ${categories.find(c=>c.id===item.category)?.label}${item.count?`, ${item.count} projects, ${item.mw} MW ordered capacity`:''}`} hidden={item.region!=='north-america'}><span class="gpf-marker-core" aria-hidden="true">{item.category==='projects'?item.count:''}</span></button>)}
      <div class="gpf-tooltip" data-marker-tooltip role="status" aria-live="polite" hidden></div>
    </div>
    <div class="gpf-legend" aria-label="Map legend"><strong>Project Locations · Ordered Capacity</strong><div class="gpf-scale"><span class="gpf-scale-dot" style="--sample:46px"></span><span>400 MW</span></div><div class="gpf-scale"><span class="gpf-scale-dot" style="--sample:34px"></span><span>200 MW</span></div><div class="gpf-scale"><span class="gpf-scale-dot" style="--sample:25px"></span><span>100 MW</span></div><div class="gpf-scale"><span class="gpf-scale-dot" style="--sample:17px"></span><span>10 MW</span></div><small>Each blue circle represents a project location. Its size indicates the total ordered capacity (MW), while the number inside shows how many projects are associated with that location.</small><div class="gpf-legend-rule"></div>{categories.filter(c=>c.id!=='projects').map(c=><div class="gpf-legend-item"><span class="gpf-dot" style={`--dot:${c.color}`}></span>{c.label}</div>)}</div>
  </div>
  <p class="gpf-note">Illustrative overview of international project activities. Locations are approximate. Ordered capacity may include projects scheduled for future delivery.</p>
</section>
<script>
  document.querySelectorAll<HTMLElement>('[data-footprint]').forEach(root => {
    const places: Array<{city:string;country:string;category:string;detail?:string;count?:number;units?:number;mw?:number}> = JSON.parse(root.dataset.places || '[]');
    const markers=[...root.querySelectorAll<HTMLButtonElement>('.gpf-marker')];
    const images=[...root.querySelectorAll<HTMLImageElement>('[data-region-image]')];
    const tabs=[...root.querySelectorAll<HTMLButtonElement>('[data-region-tab]')];
    const tooltip=root.querySelector<HTMLElement>('[data-marker-tooltip]');
    let currentRegion='north-america';
    let currentFilter='all';
    let current=-1; // Do not preselect a location.
    const inRegion=(index:number)=>markers[index]?.dataset.region===currentRegion;
    function describe(index:number){
      const p=places[index];const m=markers[index];if(!p||!m||!tooltip||m.hidden)return;
      const countryCodes: Record<string,string> = {
        'United States':'USA', 'Canada':'CAN', 'Mexico':'MEX',
        'United Kingdom':'GBR', 'Belgium':'BEL', 'Australia':'AUS',
        'New Zealand':'NZL', 'Czech Republic':'CZE',
        'Finland':'FIN', 'Italy':'ITA', 'Hungary':'HUN'
      };
      tooltip.replaceChildren();
      const heading=document.createElement('strong');
      heading.textContent=`${p.city}, ${countryCodes[p.country] || p.country}`;
      tooltip.append(heading);
      if(p.category==='projects'){
        const detail=document.createElement('span');
        detail.textContent=` · ${p.count} ${p.count===1?'project':'projects'} · ${p.mw} MW`;
        tooltip.append(detail);
      }
      // Position after measuring the tooltip, keeping it fully inside the map.
      tooltip.hidden=false;
      tooltip.style.left='0px';
      tooltip.style.top='0px';
      tooltip.style.transform='none';
      const map=tooltip.parentElement!;
      const mapRect=map.getBoundingClientRect();
      const markerRect=m.getBoundingClientRect();
      const tooltipWidth=tooltip.offsetWidth;
      const tooltipHeight=tooltip.offsetHeight;
      const padding=8;
      const gap=12;
      const centerX=markerRect.left+markerRect.width/2-mapRect.left;
      const markerTop=markerRect.top-mapRect.top;
      const markerBottom=markerRect.bottom-mapRect.top;
      const x=Math.max(padding,Math.min(centerX-tooltipWidth/2,mapRect.width-tooltipWidth-padding));
      const above=markerTop-tooltipHeight-gap>=padding;
      const y=above ? markerTop-tooltipHeight-gap : markerBottom+gap;
      tooltip.style.left=`${Math.round(x)}px`;
      tooltip.style.top=`${Math.round(Math.max(padding,Math.min(y,mapRect.height-tooltipHeight-padding)))}px`;
    }
    function hideTooltip(){if(tooltip)tooltip.hidden=true;}

    function show(index:number){const p=places[index];if(!p)return;
      if(!inRegion(index)){const region=markers[index]?.dataset.region;if(region)currentRegion=region;}
      if(currentFilter!=='all'&&p.category!==currentFilter)currentFilter='all';
      current=index;renderVisibility();
      markers.forEach(m=>m.classList.toggle('is-selected',Number(m.dataset.index)===index));
      describe(index);
    }
    function renderVisibility(){
      tabs.forEach(t=>{const active=t.dataset.regionTab===currentRegion;t.classList.toggle('is-active',active);t.setAttribute('aria-pressed',String(active));});
      images.forEach(img=>img.hidden=img.dataset.regionImage!==currentRegion);
      root.querySelectorAll<HTMLButtonElement>('[data-filter]').forEach(b=>{const active=b.dataset.filter===currentFilter;b.classList.toggle('is-active',active);b.setAttribute('aria-pressed',String(active));});
      markers.forEach(m=>m.hidden=m.dataset.region!==currentRegion||(currentFilter!=='all'&&m.dataset.category!==currentFilter));
    }
    function clearSelection(){
      current=-1;
      markers.forEach(m=>m.classList.remove('is-selected'));
      hideTooltip();
    }
    tabs.forEach(t=>t.addEventListener('click',()=>{
      currentRegion=t.dataset.regionTab||'north-america';
      clearSelection();
      renderVisibility();
    }));
    root.querySelectorAll<HTMLButtonElement>('[data-filter]').forEach(b=>b.addEventListener('click',()=>{
      currentFilter=b.dataset.filter||'all';
      clearSelection();
      renderVisibility();
    }));
    markers.forEach(m=>{
      const index=Number(m.dataset.index);
      m.addEventListener('click',()=>show(index));
      m.addEventListener('mouseenter',()=>describe(index));
      m.addEventListener('mouseleave',()=>{if(current>=0&&markers[current]&&!markers[current].hidden)describe(current);else hideTooltip();});
      m.addEventListener('focus',()=>describe(index));
      m.addEventListener('blur',()=>{if(current>=0&&markers[current]&&!markers[current].hidden)describe(current);else hideTooltip();});
    });
    renderVisibility();
  });
</script>
