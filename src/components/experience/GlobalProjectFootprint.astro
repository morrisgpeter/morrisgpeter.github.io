/**
 * Global Footprint — v15 regional interactive maps.
 * Coordinates are approximate city centers, not customer or facility addresses.
 * Validate role attribution and public disclosure before release.
 */
const categories = [
  { id: 'projects', label: 'Projects', color: '#2878c6' },
  { id: 'manufacturing', label: 'Manufacturing', color: '#249779' },
  { id: 'suppliers', label: 'Suppliers', color: '#dc8b36' },
  { id: 'demonstrations', label: 'Technology Demonstrations', color: '#8c63bb' },
];
const locations = [
  // Projects consolidated by city from 20 order records (2021–2026).
  { city: 'Lévis', country: 'Canada', lat: 46.74, lon: -71.18, category: 'projects', count: 5, units: 39, mw: 95.75 },
  { city: 'London', country: 'United Kingdom', lat: 51.51, lon: -0.13, category: 'projects', count: 1, units: 15, mw: 37.5 },
  { city: 'Brussels', country: 'Belgium', lat: 50.85, lon: 4.35, category: 'projects', count: 1, units: 4, mw: 10 },
  { city: 'Sydney', country: 'Australia', lat: -33.87, lon: 151.21, category: 'projects', count: 1, units: 2, mw: 5 },
  { city: 'Bossier City', country: 'United States', lat: 32.52, lon: -93.73, category: 'projects', count: 1, units: 1, mw: 2.5 },
  { city: 'Ellendale', country: 'United States', lat: 46.00, lon: -98.53, category: 'projects', count: 4, units: 160, mw: 400 },
  { city: 'El Cajon', country: 'United States', lat: 32.79, lon: -116.96, category: 'projects', count: 1, units: 3, mw: 7.5 },
  { city: 'Fargo', country: 'United States', lat: 46.88, lon: -96.79, category: 'projects', count: 4, units: 160, mw: 400 },
  { city: 'Austin', country: 'United States', lat: 30.27, lon: -97.74, category: 'projects', count: 1, units: 20, mw: 50 },
  { city: 'Dallas', country: 'United States', lat: 32.78, lon: -96.80, category: 'projects', count: 1, units: 80, mw: 200 },
  // Manufacturing, FAT, suppliers and demonstrations (city centers, not site addresses).
  { city: 'Napier', country: 'New Zealand', lat: -39.49, lon: 176.92, category: 'manufacturing', detail: 'Manufacturing, testing and customer FAT coordination' },
  { city: 'San Luis Potosí', country: 'Mexico', lat: 22.15, lon: -100.98, category: 'manufacturing', detail: 'Manufacturing' },
  { city: 'Mebane', country: 'United States', lat: 36.10, lon: -79.27, category: 'manufacturing', detail: 'Manufacturing' },
  { city: 'Brno', country: 'Czech Republic', lat: 49.20, lon: 16.61, category: 'manufacturing', detail: 'Manufacturing' },
  { city: 'Trutnov', country: 'Czech Republic', lat: 50.56, lon: 15.91, category: 'suppliers' },
  { city: 'Kaarina', country: 'Finland', lat: 60.41, lon: 22.37, category: 'suppliers' },
  { city: 'Busto Arsizio', country: 'Italy', lat: 45.61, lon: 8.85, category: 'suppliers' },
  { city: 'Wytheville', country: 'United States', lat: 36.95, lon: -81.09, category: 'suppliers' },
  { city: 'Kecskemét', country: 'Hungary', lat: 46.91, lon: 19.69, category: 'suppliers' },
  { city: 'Brno', country: 'Czech Republic', lat: 49.20, lon: 16.61, category: 'demonstrations', detail: 'HiPerGuard First of Kind (FoK) demonstration' },
  { city: 'Napier', country: 'New Zealand', lat: -39.49, lon: 176.92, category: 'demonstrations', detail: 'Technology demonstrations (classification pending confirmation)' },
];
// The regional maps are cropped directly from the original world map SVG.
// Regional bounds use the same equirectangular projection as that asset.
const regions = [
  { id:'north-america', label:'North America', subtitle:'United States · Canada · Mexico', box:[150,95,300,145] },
  { id:'europe', label:'Europe', subtitle:'Projects · manufacturing · suppliers', box:[540,67,225,108] },
  { id:'oceania', label:'Oceania', subtitle:'Australia · New Zealand', box:[950,334,248,118] },
] as const;
const regionFor = (country:string) => ['United States','Canada','Mexico'].includes(country) ? 'north-america' : ['Australia','New Zealand'].includes(country) ? 'oceania' : 'europe';
const project = (lon:number, lat:number) => ({x:(lon+180)/360*1200, y:(85-lat)/170*570});
// Marker-only layout: no leader lines. Offsets prevent overlap while staying
// near city centers. Values use the source map's 1200 × 570 coordinate system.
const offsets: Record<string,[number,number]> = {
  'Ellendale:projects':[-7,-2], 'Fargo:projects':[7,-2],
  'Dallas:projects':[2,-2], 'Austin:projects':[-5,4],
  'Bossier City:projects':[2,1],
  'Brno:manufacturing':[-1.7,1.5], 'Brno:demonstrations':[1.7,1.5],
  'Trutnov:suppliers':[-1.5,-2.5],
  // Small separation around Napier's actual position on NZ North Island.
  'Napier:manufacturing':[-2.0,-1.2], 'Napier:demonstrations':[2.0,1.2],
};
const markers = locations.map((item,index)=>{
  const region=regionFor(item.country);
  const box=regions.find(r=>r.id===region)!.box;
  const anchor=project(item.lon,item.lat);
  const [dx,dy]=offsets[`${item.city}:${item.category}`]||[0,0];
  const x=(anchor.x-box[0]+dx)/box[2]*100;
  const y=(anchor.y-box[1]+dy)/box[3]*100;
  return {...item,index,region,x,y,anchorX:(anchor.x-box[0])/box[2]*100,anchorY:(anchor.y-box[1])/box[3]*100,
    diameter:item.category==='projects'?Math.round(14+38*Math.sqrt((item.mw||0)/400)):12};
});
const uniqueCities=(region:string)=>new Set(markers.filter(m=>m.region===region).map(m=>`${m.city}|${m.country}`)).size;
---
