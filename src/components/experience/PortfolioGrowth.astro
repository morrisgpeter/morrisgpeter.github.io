---
// Order dates and nominal capacities transcribed from ABB_Project_Orders_2021-2026(2).xlsx.
// The spreadsheet labels its capacity column MW; MVA presentation follows the owner's
// instruction to treat the equipment's nominal rating as apparent power.
const orders = [
  {
    "date": "2021-07-30",
    "mva": 15.75
  },
  {
    "date": "2022-12-21",
    "mva": 20.0
  },
  {
    "date": "2023-01-26",
    "mva": 37.5
  },
  {
    "date": "2023-08-02",
    "mva": 10.0
  },
  {
    "date": "2023-08-24",
    "mva": 5.0
  },
  {
    "date": "2024-01-11",
    "mva": 2.5
  },
  {
    "date": "2024-11-25",
    "mva": 20.0
  },
  {
    "date": "2025-01-02",
    "mva": 100.0
  },
  {
    "date": "2025-03-24",
    "mva": 100.0
  },
  {
    "date": "2025-04-16",
    "mva": 20.0
  },
  {
    "date": "2025-06-16",
    "mva": 7.5
  },
  {
    "date": "2025-12-18",
    "mva": 100.0
  },
  {
    "date": "2025-12-19",
    "mva": 100.0
  },
  {
    "date": "2025-12-23",
    "mva": 100.0
  },
  {
    "date": "2025-12-31",
    "mva": 100.0
  },
  {
    "date": "2026-01-20",
    "mva": 50.0
  },
  {
    "date": "2026-03-04",
    "mva": 100.0
  },
  {
    "date": "2026-03-04",
    "mva": 100.0
  },
  {
    "date": "2026-09-16",
    "mva": 200.0
  },
  {
    "date": "2026-10-09",
    "mva": 20.0
  }
];
const initiatives = [
  { id: 1, date: '2023-08-01', label: 'Aug 2023', title: 'Cross-Border VAT Resolution', description: 'Helped resolve tax and commercial risks in an international supply model, protecting project economics and supporting a repeatable delivery approach.' },
  { id: 2, date: '2024-11-01', label: 'Nov 2024', title: 'MV UPS Project Delivery Workflow', description: 'Developed and finalized the project delivery workflow to improve coordination and clarify execution responsibilities.' },
  { id: 3, date: '2025-01-01', label: 'Jan 2025', title: 'Business Model Workshop', description: 'Presented lessons learned and the project delivery workflow to senior representatives from Sales, Service, Business Units, Project Management, Marketing and Product Management.' },
  { id: 4, date: '2025-08-04', label: 'Aug 2025', title: 'Product Documentation Package', description: 'Published a structured document register mapping approved product documentation to stakeholder groups and access requirements.' },
];
const start = Date.parse('2023-01-01T00:00:00Z');
const end = Date.parse('2026-12-31T00:00:00Z');
const x0 = 72, x1 = 960, y0 = 312, y1 = 35, yMax = 1400;
const baseline = orders.filter((row) => row.date < '2023-01-01').reduce((sum, row) => sum + row.mva, 0);
const displayOrders = orders.filter((row) => row.date >= '2023-01-01');
const x = (date) => x0 + (Date.parse(`${date}T00:00:00Z`) - start) / (end - start) * (x1 - x0);
const y = (capacity) => y0 - capacity / yMax * (y0 - y1);
let running = baseline;
const points = displayOrders.map((row) => { running += row.mva; return { ...row, cumulative: running, x: x(row.date), y: y(running) }; });
let path = `M ${x0} ${y(baseline)}`;
for (const point of points) path += ` H ${point.x} V ${point.y}`;
path += ` H ${x1}`;
const areaPath = `${path} V ${y0} H ${x0} Z`;
const milestones = initiatives.map((item) => {
  const cumulative = orders.filter((row) => row.date <= item.date).reduce((sum, row) => sum + row.mva, 0);
  return { ...item, cumulative, x: x(item.date), y: y(cumulative) };
});
const ticks = [0, 200, 400, 600, 800, 1000, 1200, 1400];
const years = [2023, 2024, 2025, 2026];
// Compact mobile-only plot: same source data and cumulative baseline, fitted to a
// narrow viewport without horizontal scrolling or clipped milestones.
const mobileX0 = 43, mobileX1 = 396, mobileY0 = 238, mobileY1 = 26;
const mobileX = (date) => mobileX0 + (Date.parse(`${date}T00:00:00Z`) - start) / (end - start) * (mobileX1 - mobileX0);
const mobileY = (capacity) => mobileY0 - capacity / yMax * (mobileY0 - mobileY1);
let mobilePath = `M ${mobileX0} ${mobileY(baseline)}`;
for (const point of points) mobilePath += ` H ${mobileX(point.date)} V ${mobileY(point.cumulative)}`;
mobilePath += ` H ${mobileX1}`;
const mobileAreaPath = `${mobilePath} V ${mobileY0} H ${mobileX0} Z`;
const mobileMilestones = milestones.map((item) => ({ ...item, x: mobileX(item.date), y: mobileY(item.cumulative) }));
const mobileTicks = [0, 400, 800, 1200];
const shortLabels = { 1: ['VAT', 'Resolution'], 2: ['Delivery', 'Workflow'], 3: ['Business Model', 'Workshop'], 4: ['Documentation', 'Package'] };
---
<section class="portfolio-growth" aria-labelledby="portfolio-growth-title">
  <header class="portfolio-head">
    <div class="portfolio-headline">
      <p class="portfolio-eyebrow">PROJECT DELIVERY SCALE &amp; PORTFOLIO VALUE</p>
      <h3 id="portfolio-growth-title">Scaling MV UPS to 1,200 MVA</h3>
      <p>Cumulative ordered capacity and key initiatives that strengthened delivery governance and operational readiness during a period of accelerated growth.</p>
    </div>
    <div class="portfolio-kpis" aria-label="Portfolio totals">
      <div class="portfolio-kpi"><strong>1,200 MVA</strong><span>Total Ordered Capacity</span><small>2021–Oct 2026</small></div>
      <div class="portfolio-kpi"><strong>USD 255M</strong><span>Total Order Value</span><small>2021–Oct 2026</small></div>
    </div>
  </header>
  <div class="portfolio-chart-panel">
    <h4>Cumulative MV UPS Order Capacity (MVA)</h4>
    <p class="portfolio-chart-subtitle">Cumulative portfolio capacity (MVA) and key initiatives supporting project delivery and governance.</p>
    <div class="portfolio-chart-scroll">
      <svg class="portfolio-chart-desktop" viewBox="0 0 1000 365" role="img" aria-label="Step chart showing cumulative nominal ordered capacity from January 2023 to October 2026, ending at approximately 1,200 MVA, with four professional initiative markers.">
        <defs><linearGradient id="portfolio-area-gradient" x1="0" x2="0" y1="0" y2="1"><stop offset="0%" stop-color="#4a9cda" stop-opacity=".3"/><stop offset="100%" stop-color="#4a9cda" stop-opacity=".035"/></linearGradient></defs>
        {ticks.map((tick) => <g><line x1={x0} x2={x1} y1={y(tick)} y2={y(tick)} class="portfolio-grid"/><text x={x0 - 12} y={y(tick) + 5} class="portfolio-axis" text-anchor="end">{tick.toLocaleString('en-US')}</text></g>)}
        {years.map((year) => <g><line x1={x(`${year}-01-01`)} x2={x(`${year}-01-01`)} y1={y1} y2={y0} class="portfolio-year-grid"/><text x={x(`${year}-01-01`)} y="339" class="portfolio-axis" text-anchor="middle">{year}</text></g>)}
        <path d={areaPath} fill="url(#portfolio-area-gradient)"/>
        <path d={path} class="portfolio-step-line"/>
        {milestones.map((item) => <g>
          <line x1={item.x} x2={item.x} y1={item.y - 10} y2={Math.max(y1 + 8, item.y - 48)} class="portfolio-marker-line"/>
          <circle cx={item.x} cy={item.y} r="7" class="portfolio-marker-dot"/>
          <circle cx={item.x} cy={Math.max(y1 + 8, item.y - 48)} r="13" class="portfolio-marker-number"/>
          <text x={item.x} y={Math.max(y1 + 8, item.y - 48) + 5} text-anchor="middle" class="portfolio-marker-label">{item.id}</text>
          <text x={item.x + (item.id === 2 ? -27 : item.id === 3 ? 32 : 0)} y={Math.max(y1 + 8, item.y - 48) - 25} text-anchor="middle" class="portfolio-event-title">
            {shortLabels[item.id].map((line, index) => <tspan x={item.x + (item.id === 2 ? -27 : item.id === 3 ? 32 : 0)} dy={index === 0 ? 0 : 13}>{line}</tspan>)}
          </text>
        </g>)}
        <circle cx={points[points.length - 1].x} cy={points[points.length - 1].y} r="6" fill="#1d6aa8" stroke="white" stroke-width="2"/>
        <text x="960" y="17" text-anchor="end" class="portfolio-end-label">Oct 2026 · 1,200 MVA</text>
      </svg>
      <svg class="portfolio-chart-mobile" viewBox="0 0 420 278" role="img" aria-label="Mobile step chart of cumulative MV UPS ordered capacity from 2023 to 2026, with four numbered milestones. Select the numbered buttons below for details.">
        {mobileTicks.map((tick) => <g><line x1={mobileX0} x2={mobileX1} y1={mobileY(tick)} y2={mobileY(tick)} class="portfolio-grid"/><text x={mobileX0 - 8} y={mobileY(tick) + 4} class="portfolio-axis" text-anchor="end">{tick.toLocaleString('en-US')}</text></g>)}
        {years.map((year) => <g><line x1={mobileX(`${year}-01-01`)} x2={mobileX(`${year}-01-01`)} y1={mobileY1} y2={mobileY0} class="portfolio-year-grid"/><text x={mobileX(`${year}-01-01`)} y="261" class="portfolio-axis" text-anchor="middle">{year}</text></g>)}
        <path d={mobileAreaPath} fill="url(#portfolio-area-gradient-mobile)"/>
        <defs><linearGradient id="portfolio-area-gradient-mobile" x1="0" x2="0" y1="0" y2="1"><stop offset="0%" stop-color="#4a9cda" stop-opacity=".3"/><stop offset="100%" stop-color="#4a9cda" stop-opacity=".035"/></linearGradient></defs>
        <path d={mobilePath} class="portfolio-step-line"/>
        {mobileMilestones.map((item) => <g>
          <line x1={item.x} x2={item.x} y1={item.y - 5} y2={item.y - 28} class="portfolio-marker-line"/>
          <circle cx={item.x} cy={item.y} r="4.5" class="portfolio-marker-dot"/>
          <circle cx={item.x} cy={item.y - 36} r="11" class="portfolio-marker-number"/>
          <text x={item.x} y={item.y - 32} text-anchor="middle" class="portfolio-marker-label">{item.id}</text>
        </g>)}
        <circle cx={mobileX(points[points.length - 1].date)} cy={mobileY(points[points.length - 1].cumulative)} r="4.5" fill="#1d6aa8" stroke="white" stroke-width="2"/>
      </svg>
    </div>
    <div class="portfolio-milestone-buttons" role="group" aria-label="Explore key initiatives">
      {initiatives.map((item) => <button type="button" class="portfolio-milestone-button" data-initiative={item.id} aria-pressed={item.id === 1 ? 'true' : 'false'}><span>{item.id}</span><span>{item.label}</span></button>)}
    </div>
    <p class="portfolio-chart-note">The chart begins in Jan 2023 and includes earlier orders in the cumulative baseline. Milestones are independent initiatives, not orders. Capacity is nominal ordered capacity, not completed deliveries.</p>
  </div>
  <section class="portfolio-initiatives" aria-labelledby="portfolio-initiatives-title">
    <h4 id="portfolio-initiatives-title">Key Initiatives</h4>
    <ol>
      {initiatives.map((item) => <li class:list={['portfolio-initiative', { 'is-selected': item.id === 1 }]} data-item={item.id}><button type="button" data-select={item.id} aria-label={`Highlight initiative ${item.id}: ${item.title}`}>{item.id}</button><div><h5>{item.label} — {item.title}</h5><p>{item.description}</p></div></li>)}
    </ol>
  </section>
</section>
<script>
  document.querySelectorAll('.portfolio-growth').forEach((root) => {
    if (root.dataset.ready) return;
    root.dataset.ready = 'true';
    const select = (id) => {
      root.querySelectorAll('[data-item]').forEach((node) => node.classList.toggle('is-selected', node.dataset.item === id));
      root.querySelectorAll('[data-initiative]').forEach((node) => node.setAttribute('aria-pressed', String(node.dataset.initiative === id)));
    };
    root.querySelectorAll('[data-select], [data-initiative]').forEach((button) => button.addEventListener('click', () => select(button.dataset.select || button.dataset.initiative)));
  });
</script>
<style>
  .portfolio-growth{margin-bottom:1rem;color:#173352}.portfolio-head{display:grid;grid-template-columns:minmax(0,1.5fr) minmax(0,1fr);gap:1.2rem;align-items:center;margin-bottom:1rem}.portfolio-eyebrow{font-size:.73rem!important;font-weight:800;letter-spacing:.14em;color:#3676ae!important;margin:0 0 .55rem!important}.portfolio-headline h3{font-size:clamp(1.5rem,2.6vw,2.2rem);letter-spacing:-.025em;line-height:1.2;margin:0 0 .6rem;color:#102b50}.portfolio-headline>p:last-child{line-height:1.6;color:#52657d;margin:0;font-size:.94rem}.portfolio-kpis{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:.75rem}.portfolio-kpi{border:1px solid #dbe9f5;border-radius:12px;background:#eaf3fc;padding:1.1rem;display:flex;flex-direction:column;gap:.35rem}.portfolio-kpi strong{font-size:clamp(1.45rem,2.5vw,2rem);letter-spacing:-.03em;color:#123c74;white-space:nowrap}.portfolio-kpi span{font-size:.85rem;font-weight:700;color:#325b82}.portfolio-kpi small{font-size:.76rem;line-height:1.45;color:#536c84}.portfolio-chart-panel,.portfolio-initiatives{background:white;border:1px solid #e1eaf4;border-radius:14px;padding:1.3rem;margin-bottom:1rem;box-shadow:0 5px 18px rgba(23,57,96,.035)}.portfolio-chart-panel h4,.portfolio-initiatives h4{margin:0;color:#113460;font-size:1.15rem}.portfolio-chart-subtitle{font-size:.82rem;color:#62788e;margin:.3rem 0 .8rem}.portfolio-chart-scroll{width:100%;overflow:hidden}.portfolio-chart-scroll svg{display:block;width:100%;height:auto}.portfolio-chart-mobile{display:none!important}.portfolio-grid{stroke:#dbe7f1;stroke-dasharray:3 5}.portfolio-year-grid{stroke:#e5edf6;stroke-dasharray:3 5}.portfolio-axis{font-size:14px;fill:#64788d}.portfolio-step-line{stroke:#2677bb;stroke-width:3;fill:none;stroke-linejoin:round}.portfolio-marker-line{stroke:#3e6f9a;stroke-width:1.5;stroke-dasharray:4 4}.portfolio-marker-dot{fill:#2677bb;stroke:white;stroke-width:2}.portfolio-marker-number{fill:#165d9c;stroke:white;stroke-width:2}.portfolio-marker-label{font-size:14px;fill:white;font-weight:800}.portfolio-event-title{font-size:11px;fill:#173e69;font-weight:700;paint-order:stroke;stroke:white;stroke-width:3px;stroke-linejoin:round}.portfolio-end-label{font-size:15px;fill:#173e69;font-weight:800}.portfolio-milestone-buttons{display:flex;gap:.5rem;flex-wrap:wrap;margin-top:.35rem}.portfolio-milestone-button{display:inline-flex;align-items:center;gap:.45rem;border:1px solid #d6e4f2;border-radius:999px;background:#f5f9fd;color:#234b70;padding:.38rem .75rem;min-height:40px;cursor:pointer;font-size:.8rem}.portfolio-milestone-button span:first-child{background:#246fae;color:white;border-radius:50%;width:23px;height:23px;display:grid;place-items:center;font-weight:800}.portfolio-milestone-button[aria-pressed=true]{background:#dcecf9;border-color:#448fc8}.portfolio-milestone-button:focus-visible,.portfolio-initiative button:focus-visible{outline:3px solid #76b6eb;outline-offset:3px}.portfolio-chart-note{font-size:.77rem;color:#62788e;line-height:1.55;margin:.85rem 0 0}.portfolio-initiatives ol{list-style:none;padding:0;margin:1rem 0 0;display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:.9rem 1.4rem}.portfolio-initiative{display:flex;gap:.7rem;padding:.55rem;border-radius:9px;border:1px solid transparent;min-width:0}.portfolio-initiative.is-selected{background:#eff6fc;border-color:#d4e5f5}.portfolio-initiative button{flex:0 0 31px;width:31px;height:31px;border:0;border-radius:50%;background:#2677bb;color:white;font-weight:800;cursor:pointer}.portfolio-initiative h5{margin:0 0 .3rem;font-size:.88rem;color:#173e69}.portfolio-initiative p{margin:0;font-size:.84rem;line-height:1.6;color:#52657d}@media(max-width:920px){.portfolio-head{grid-template-columns:1fr}}@media(max-width:650px){.portfolio-chart-desktop{display:none!important}.portfolio-chart-mobile{display:block!important;max-width:100%;min-width:0}.portfolio-kpis{grid-template-columns:repeat(2,minmax(0,1fr))}.portfolio-kpi{padding:.75rem}.portfolio-kpi strong{font-size:1.35rem}.portfolio-chart-panel,.portfolio-initiatives{padding:1rem}.portfolio-initiatives ol{grid-template-columns:1fr}.portfolio-headline h3{font-size:1.6rem}}@media(max-width:360px){.portfolio-kpis{grid-template-columns:1fr}}
</style>
