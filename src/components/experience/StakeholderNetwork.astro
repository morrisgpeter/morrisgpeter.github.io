---
// Collaboration interfaces, grouped by level of interaction rather than reporting line.
const groups = [
  {
    level: 'Strategic', descriptor: 'Direction & decisions', tone: 'strategic',
    functions: [
      { label: 'Customers', icon: 'users' },
      { label: 'Sales', icon: 'trend' },
      { label: 'Business units', icon: 'building' },
      { label: 'Finance', icon: 'coins' },
      { label: 'Legal & contracts', icon: 'file' },
    ],
  },
  {
    level: 'Management', descriptor: 'Planning & alignment', tone: 'management',
    functions: [
      { label: 'Project management', icon: 'clipboard' },
      { label: 'Product management', icon: 'settings' },
      { label: 'Agile units', icon: 'circuit' },
      { label: 'Supply chain & procurement', icon: 'supply-network' },
      { label: 'Operations', icon: 'truck' },
      { label: 'Service', icon: 'wrench' },
    ],
  },
  {
    level: 'Operational', descriptor: 'Execution & acceptance', tone: 'operational',
    functions: [
      { label: 'Engineering', icon: 'circuit' },
      { label: 'Quality', icon: 'shield' },
      { label: 'Manufacturing & IPU', icon: 'factory' },
      { label: 'Planning & fulfilment', icon: 'calendar' },
      { label: 'Logistics', icon: 'package' },
      { label: 'Customer service', icon: 'users' },
      { label: 'Site & commissioning support', icon: 'check' },
    ],
  },
];
---
<section class="stakeholder-network" aria-label="Collaboration interfaces grouped into strategic, management and operational levels">
  <!-- Reusable outline icons. Decorative: each icon is accompanied by a visible label. -->
  <svg class="icon-defs" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" focusable="false">
    <symbol id="sn-users" viewBox="0 0 24 24"><circle cx="9" cy="8" r="3"/><path d="M3 20v-2a6 6 0 0 1 12 0v2M17 5a3 3 0 0 1 0 6m2 3a5 5 0 0 1 2 4v2"/></symbol>
    <symbol id="sn-trend" viewBox="0 0 24 24"><path d="m3 17 6-6 4 4 8-9M15 6h6v6"/></symbol>
    <symbol id="sn-building" viewBox="0 0 24 24"><rect x="4" y="4" width="16" height="16" rx="1"/><path d="M8 8h2m4 0h2M8 12h2m4 0h2M10 20v-4h4v4"/></symbol>
    <symbol id="sn-coins" viewBox="0 0 24 24"><ellipse cx="12" cy="6" rx="7" ry="3"/><path d="M5 6v5c0 1.7 3.1 3 7 3s7-1.3 7-3V6M5 11v6c0 1.7 3.1 3 7 3s7-1.3 7-3v-6"/></symbol>
    <symbol id="sn-file" viewBox="0 0 24 24"><path d="M6 3h9l4 4v14H6zM15 3v5h4M9 12h7M9 16h7"/></symbol>
    <symbol id="sn-clipboard" viewBox="0 0 24 24"><rect x="5" y="5" width="14" height="16" rx="2"/><rect x="9" y="3" width="6" height="4" rx="1"/><path d="m9 14 2 2 4-4"/></symbol>
    <symbol id="sn-settings" viewBox="0 0 24 24"><path d="M10 2h4l.6 2.4 2 .9 2.2-1.1 2.8 2.8-1.1 2.2.9 2L24 12l-2.6.8-.9 2 1.1 2.2-2.8 2.8-2.2-1.1-2 .9L14 22h-4l-.6-2.4-2-.9-2.2 1.1-2.8-2.8 1.1-2.2-.9-2L0 12l2.6-.8.9-2-1.1-2.2 2.8-2.8 2.2 1.1 2-.9z" transform="translate(2 2) scale(.83)"/><circle cx="12" cy="12" r="3"/></symbol>
    <symbol id="sn-truck" viewBox="0 0 24 24"><path d="M2 6h12v12H2zM14 10h4l4 4v4h-8z"/><circle cx="7" cy="19" r="2"/><circle cx="18" cy="19" r="2"/></symbol>
    <symbol id="sn-wrench" viewBox="0 0 24 24"><path d="M14 5a6 6 0 0 0-7 7l-5 5a3 3 0 0 0 5 5l5-5a6 6 0 0 0 7-7l-4 4-4-4z"/></symbol>
    <symbol id="sn-shield" viewBox="0 0 24 24"><path d="M12 2 20 5v6c0 5-3.4 8.6-8 11-4.6-2.4-8-6-8-11V5z"/><path d="m8 12 3 3 5-6"/></symbol>
    <symbol id="sn-circuit" viewBox="0 0 24 24"><path d="M3 7h7l4 5h7M3 17h7l4-5h7"/><circle cx="3" cy="7" r="2"/><circle cx="3" cy="17" r="2"/><circle cx="21" cy="12" r="2"/></symbol>
    <symbol id="sn-factory" viewBox="0 0 24 24"><path d="M3 21V10l6 4v-4l6 4V6h6v15zM17 6V3h3v3M7 18h2m3 0h2m3 0h2"/></symbol>
    <symbol id="sn-calendar" viewBox="0 0 24 24"><rect x="3" y="5" width="18" height="16" rx="2"/><path d="M7 3v4m10-4v4M3 10h18m-13 5 3 3 5-5"/></symbol>
    <symbol id="sn-package" viewBox="0 0 24 24"><path d="m12 2 9 5v10l-9 5-9-5V7zM3 7l9 5 9-5m-9 5v10M8 4l9 5"/></symbol>
    <symbol id="sn-supply-network" viewBox="0 0 24 24"><rect x="9" y="2" width="6" height="6" rx="1"/><rect x="2" y="16" width="6" height="6" rx="1"/><rect x="16" y="16" width="6" height="6" rx="1"/><path d="M12 8v4M5 16v-4h14v4"/></symbol>
    <symbol id="sn-cart" viewBox="0 0 24 24"><path d="M2 4h3l3 12h11l3-9H6"/><circle cx="10" cy="20" r="1.5"/><circle cx="18" cy="20" r="1.5"/></symbol>
    <symbol id="sn-check" viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><path d="m7 12 3 3 7-7"/></symbol>
  </svg>
  <div class="network-layout">
    <div class="bulb-column" aria-hidden="true">
      <svg class="bulb" viewBox="0 0 220 420" xmlns="http://www.w3.org/2000/svg">
        <defs>
          <clipPath id="sn-bulb-outline"><path d="M110 30 C51 30 27 69 27 119 C27 160 49 179 62 204 C75 229 79 251 79 279 L141 279 C141 251 145 229 158 204 C171 179 193 160 193 119 C193 69 169 30 110 30 Z"/></clipPath>
        </defs>
        <g stroke="#6ba5d8" stroke-width="5" stroke-linecap="round">
          <path d="M110 5v15M36 29 24 17M184 29l12-12M9 110h13M198 110h13"/>
        </g>
        <g clip-path="url(#sn-bulb-outline)">
          <rect x="20" y="30" width="180" height="93" fill="#174c91"/>
          <rect x="20" y="123" width="180" height="83" fill="#438cce"/>
          <rect x="20" y="206" width="180" height="73" fill="#dceaf9"/>
          <path d="M20 123h180M20 206h180" stroke="white" stroke-width="5"/>
        </g>
        <!-- Labels are part of the bulb, connecting each color to its stakeholder level. -->
        <g font-family="Arial, Helvetica, sans-serif" font-weight="700" font-size="16" text-anchor="middle">
          <text x="110" y="83" fill="#ffffff">Strategic</text>
          <text x="110" y="169" fill="#ffffff">Management</text>
          <text x="110" y="243" fill="#17385e">Operational</text>
        </g>
        <g fill="none" stroke="#aac3df" stroke-width="2"><path d="M110 280v18"/></g>
        <rect x="76" y="301" width="68" height="13" rx="6" fill="#a7bad0"/>
        <rect x="79" y="319" width="62" height="13" rx="6" fill="#a7bad0"/>
        <rect x="83" y="337" width="54" height="13" rx="6" fill="#a7bad0"/>
        <path d="M91 356h38c0 15-9 23-19 23s-19-8-19-23" fill="#a7bad0"/>
      </svg>
    </div>
    <div class="stakeholder-rows">
      {groups.map((group) => (
        <div class={`stakeholder-row ${group.tone}`} aria-label={`${group.level}: ${group.descriptor}`}>
          <ul class="function-list">
            {group.functions.map((item) => (
              <li>
                <svg class="function-icon" aria-hidden="true" focusable="false"><use href={`#sn-${item.icon}`}></use></svg>
                <span>{item.label}</span>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </div>
</section>
<style>
  .stakeholder-network{margin-top:1.1rem;color:#17385e}
  .icon-defs{position:absolute;width:0;height:0;overflow:hidden}
  .network-layout{display:grid;grid-template-columns:175px minmax(0,1fr);align-items:center;gap:1rem}
  .bulb-column{height:100%;display:flex;align-items:center;justify-content:center;min-width:0}
  .bulb{display:block;width:min(100%,165px);max-height:365px;height:auto}
  .stakeholder-rows{display:grid;grid-template-rows:repeat(3,minmax(112px,auto));gap:.6rem;min-width:0}
  .stakeholder-row{--accent:#1d5798;min-width:0;display:flex;flex-direction:column;justify-content:center;background:#f2f7fd;border-radius:14px;border:1px solid #dbe9f6;padding:.85rem 1rem}
  .stakeholder-row.management{--accent:#317cbd;background:#f1f7fd}
  .stakeholder-row.operational{--accent:#5789b4;background:#f5f9fd}
  .function-list{list-style:none;margin:0;padding:.25rem 0;display:grid;grid-template-columns:repeat(7,minmax(0,1fr));align-items:center;gap:.35rem}
  .function-list li{display:flex;align-items:center;justify-content:center;flex-direction:column;gap:.45rem;text-align:center;min-width:0;font-size:.69rem;line-height:1.25;font-weight:650;color:#23466c}
  .strategic .function-list{grid-template-columns:repeat(5,minmax(0,1fr))}
  .management .function-list{grid-template-columns:repeat(6,minmax(0,1fr))}
  .function-icon{width:28px;height:28px;flex:none;fill:none;stroke:var(--accent);stroke-width:1.65;stroke-linecap:round;stroke-linejoin:round}
  @media(max-width:950px){.network-layout{grid-template-columns:120px minmax(0,1fr);gap:.5rem}.bulb{width:115px}.stakeholder-row{padding:.6rem}.function-list li{font-size:.63rem}.function-icon{width:25px;height:25px}}
  @media(max-width:700px){.network-layout{grid-template-columns:1fr}.bulb-column{display:flex;height:auto;padding:0 0 .1rem}.bulb{width:112px;max-height:none}.stakeholder-rows{grid-template-rows:none}.stakeholder-row{padding:.85rem}.function-list,.strategic .function-list,.management .function-list{grid-template-columns:repeat(3,minmax(0,1fr));gap:1rem .5rem}.function-list li{font-size:.73rem}.function-icon{width:29px;height:29px}}
  @media(max-width:390px){.function-list,.strategic .function-list,.management .function-list{grid-template-columns:repeat(2,minmax(0,1fr))}}
  @media(prefers-reduced-motion:no-preference){.function-icon{transition:transform .18s ease}.function-list li:hover .function-icon{transform:translateY(-2px)}}
</style>
