---
import TelengeIntroduction from "./TelengeIntroduction.astro";
import TelengeProjectFootprint from "./TelengeProjectFootprint.astro";
import TelengeKeyProjects from "./TelengeKeyProjects.astro";
---

<article class="telenge-entry" aria-labelledby="telenge-title">
  <div class="telenge-marker" aria-hidden="true"></div>
  <TelengeIntroduction />
  <TelengeKeyProjects />
  <TelengeProjectFootprint />
</article>

<style>
  .telenge-entry{position:relative;margin:0 0 2.2rem;color:#152c4c}
  .telenge-marker{position:absolute;left:-39px;top:22px;width:16px;height:16px;border:3px solid #2a7ac1;border-radius:50%;background:#fff}
  @media(max-width:560px){.telenge-marker{left:-27px}}
</style>
