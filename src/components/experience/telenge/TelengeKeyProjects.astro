---
/** Telenge — Key Projects & Contracts. Historical figures supplied by portfolio owner. */
const projects = [
  {
    id: 'pstn', title: 'PSTN Expansion', client: 'Telemar · PAM',
    metric: '+310', unit: 'localities', location: 'Bahia',
    description: 'Expansion of public telephone networks to more than 310 localities across Bahia.',
    points: ['Fixed-line network expansion', 'Engineering and field delivery', 'Contract and customer coordination'],
  },
  {
    id: 'fiber', title: 'Optical Networks', client: 'Multiple contracts · Mainly Telemar',
    metric: '+4,250', unit: 'km', location: 'Bahia',
    description: 'Deployment of aerial, underground and direct-buried optical fiber networks across Bahia.',
    points: ['Network engineering and deployment', 'Multiple installation methods', 'Separate OPGW services for other clients'],
  },
  {
    id: 'maintenance', title: 'Optical Maintenance', client: 'Intelig',
    metric: '~600', unit: 'km', location: 'Salvador–Maceió',
    description: 'Maintenance of buried optical cable alongside the railway corridor connecting Salvador and Maceió.',
    points: ['Preventive and corrective maintenance', 'Regional field-team coordination', '24-hour service restoration commitment'],
  },
  {
    id: 'radio', title: 'Radio Communications', client: 'Petrobras',
    metric: '~3,500', unit: 'km²', location: 'BA · PE · RN · CE',
    description: 'Maintenance of radio communication systems serving selected regions in four northeastern states.',
    points: ['Radio system maintenance', 'Multi-state operational coordination', 'Coverage in selected regions, not entire states'],
  },
];
---

<section class="key-projects" aria-labelledby="telenge-projects-title">
  <div class="heading">
    <span class="eyebrow">KEY PROJECTS &amp; CONTRACTS</span>
    <h2 id="telenge-projects-title">Delivering and Maintaining Critical Connections</h2>
    <p>Four areas of telecommunications delivery and maintenance, spanning fixed-line, optical and radio infrastructure across Northeast Brazil.</p>
  </div>

  <div class="projects-grid">
    {projects.map((project) => (
      <article class={`project-card ${project.id}`}>
        <div class="card-heading">
          <span class="color-mark" aria-hidden="true"></span>
          <div>
            <h3>{project.title}</h3>
            <span class="client">{project.client}</span>
          </div>
        </div>
        <p class="description">{project.description}</p>
        <div class="metric-row">
          <strong>{project.metric}<small> {project.unit}</small></strong>
          <span>{project.location}</span>
        </div>
        <div class="details">
          <h4>Key activities</h4>
          <ul>{project.points.map((point) => <li>{point}</li>)}</ul>
        </div>
      </article>
    ))}
  </div>


</section>

<style>
  .key-projects{--ink:#183a60;--muted:#58728f;--border:#d9e6f4; margin:2rem 0;padding:clamp(1.2rem,3vw,2.25rem);border:1px solid var(--border);border-radius:26px;background:linear-gradient(160deg,#fff 0%,#f7faff 100%);color:var(--ink)}
  .eyebrow{display:block;color:#287ac8;font-size:.78rem;font-weight:800;letter-spacing:.14em}
  .heading h2{font-size:clamp(1.65rem,2.7vw,2.55rem);line-height:1.17;margin:.55rem 0 .6rem;letter-spacing:-.025em}
  .heading p{color:var(--muted);margin:0 0 1.15rem;line-height:1.6;max-width:960px}
  .projects-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:.85rem}
  .project-card{--accent:#2a7de1;display:flex;flex-direction:column;min-width:0;padding:1.05rem;border:1px solid var(--border);border-top:4px solid var(--accent);border-radius:17px;background:#fff}
  .project-card.fiber{--accent:#159e74}.project-card.maintenance{--accent:#f28a25}.project-card.radio{--accent:#7950e5}
  .card-heading{display:flex;gap:.75rem;align-items:flex-start;min-height:3.1rem}
  .color-mark{flex:none;width:14px;height:14px;margin-top:.32rem;border-radius:50%;background:var(--accent)}
  h3{font-size:1.07rem;line-height:1.3;margin:0 0 .3rem} .client{font-size:.78rem;font-weight:700;color:var(--muted)}
  .description{font-size:.91rem;line-height:1.6;color:#486581;min-height:5.3rem;margin:.65rem 0}
  .metric-row{display:flex;flex-wrap:wrap;gap:.3rem .8rem;align-items:baseline;padding:.7rem 0;border-top:1px solid var(--border);border-bottom:1px solid var(--border)}
  .metric-row strong{font-size:1.8rem;line-height:1.2;color:var(--accent);white-space:nowrap}.metric-row small{font-size:.85rem}.metric-row span{font-size:.8rem;color:var(--muted)}
  .details{padding-top:.7rem;flex:1}.details h4{font-size:.87rem;margin:0 0 .4rem}.details ul{margin:0;padding-left:1.15rem;color:#506b86;font-size:.85rem;line-height:1.6}.details li+li{margin-top:.2rem}
  @media(max-width:1100px){.projects-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.description{min-height:unset}}
  @media(max-width:640px){.key-projects{border-radius:22px;padding:1.1rem}.projects-grid{grid-template-columns:1fr}.project-card{padding:1.15rem}.card-heading{min-height:0}.description{margin:.8rem 0}.leadership-note{padding:1rem}}
</style>
