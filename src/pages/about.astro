    display: flex;
    align-items: center;
  }
  .entrepreneurial-card {
    width: 100%;
    padding: clamp(22px, 2.4vw, 30px);
    border-radius: 14px;
    background: #edf5fc;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    justify-content: center;
  }
  .entrepreneurial-year {
    margin: 0;
    color: #071a33;
    font-size: clamp(65px, 6vw, 90px);
    font-weight: 750;
    letter-spacing: -0.06em;
    line-height: 1;
  }
  .entrepreneurial-rule {
    width: 64px;
    height: 5px;
    margin: 18px 0 20px;
    background: #55aff0;
    border-radius: 3px;
  }
  .entrepreneurial-role {
    margin: 0 0 16px;
    color: #071a33;
    font-size: clamp(24px, 2.4vw, 34px);
    font-weight: 700;
    line-height: 1.2;
  }
  .entrepreneurial-logo {
    display: block;
    width: min(100%, 270px);
    height: auto;
    object-fit: contain;
    margin: 0 0 16px;
