<script>
  function setupGlobalMap() {
    const map = document.querySelector('.global-map-visual');
    if (!map || map.hasAttribute('data-map-ready')) return;
    map.setAttribute('data-map-ready', '');
    const detail = map.querySelector<HTMLElement>('.map-detail');
    const markers = Array.from(map.querySelectorAll<HTMLButtonElement>('.map-marker'));
    if (!detail) return;
    const close = () => {
      detail.hidden = true;
      markers.forEach((marker) => marker.setAttribute('aria-pressed', 'false'));
    };
    const open = (marker: HTMLButtonElement) => {
      detail.querySelector<HTMLElement>('.map-detail-name')!.textContent = marker.dataset.name || '';
      detail.querySelector<HTMLElement>('.map-detail-role')!.textContent = marker.dataset.role || '';
      detail.querySelector<HTMLElement>('.map-detail-description')!.textContent = marker.dataset.description || '';
      detail.hidden = false;
      markers.forEach((item) => item.setAttribute('aria-pressed', String(item === marker)));
    };
    markers.forEach((marker) => {
      marker.addEventListener('click', () => marker.getAttribute('aria-pressed') === 'true' ? close() : open(marker));
      marker.addEventListener('mouseenter', () => open(marker));
    });
    detail.querySelector('.map-detail-close')?.addEventListener('click', close);
    map.addEventListener('keydown', (event) => { if (event.key === 'Escape') close(); });
    document.addEventListener('click', (event) => { if (!map.contains(event.target as Node)) close(); });
  }
  document.addEventListener('DOMContentLoaded', setupGlobalMap);
  document.addEventListener('astro:page-load', setupGlobalMap);
</script>
