---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ForestCaseHero from "../../components/cases/forest-fire-monitoring/ForestCaseHero.astro";
import ForestOpportunity from "../../components/cases/forest-fire-monitoring/ForestOpportunity.astro";
import ForestSolution from "../../components/cases/forest-fire-monitoring/ForestSolution.astro";
import ForestBusinessModel from "../../components/cases/forest-fire-monitoring/ForestBusinessModel.astro";
import ForestOperationalFootprint from '../../components/cases/forest-fire-monitoring/ForestOperationalFootprint.astro';
import ForestBusinessImpact from "../../components/cases/forest-fire-monitoring/ForestBusinessImpact.astro";
---

<BaseLayout
  title="Forest Fire Monitoring | Representative Case | Peter Morris"
  description="How an observation in the field became a forest fire monitoring solution and a recurring-revenue business at Aton Engenharia."
>
  <main id="main-content">
    <ForestCaseHero />
    <ForestOpportunity />
    <ForestSolution />
    <ForestBusinessModel />
    <div class="forest-results-grid">
      <ForestOperationalFootprint />
      <ForestBusinessImpact />
    </div>
  </main>
</BaseLayout>

<style>
  .forest-results-grid{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);align-items:stretch;gap:1.25rem;max-width:1480px;margin:0 auto;padding:2rem 1.5rem;background:#f7fafc;}
  @media(max-width:1050px){.forest-results-grid{grid-template-columns:1fr;}}
  @media(max-width:600px){.forest-results-grid{padding:1.25rem 1rem;gap:1rem;}}
</style>
