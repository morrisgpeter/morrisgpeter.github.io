---
import BaseLayout from "../layouts/BaseLayout.astro";

const certifications = [
  {
    abbreviation: "PMP®",
    name: "Project Management Professional",
    issuer: "Project Management Institute (PMI)",
    date: "Issued April 2025 · Valid through April 2028",
    badge: "/images/certifications/pmp.png",
    url: "https://www.credly.com/badges/40e3fb6d-937a-4479-a67f-bbd3026aa5bc",
    category: "Project Management",
  },
  {
    abbreviation: "PSM I",
    name: "Professional Scrum Master I",
    issuer: "Scrum.org",
    date: "Issued November 2025",
    badge: "/images/certifications/psm-i.png",
    url: "https://www.credly.com/badges/89bcaf52-15e6-4ad1-99d8-1ee939d0bb67",
    category: "Agile & Scrum",
  },
];

const education = [
  {
    degree: "Postgraduate Studies in Data Science & Big Data",
    institution: "Federal University of Bahia (UFBA)",
    years: "2021–2023",
    crest: "/images/education/ufba.png",
    alt: "Federal University of Bahia coat of arms",
    category: "Data Science",
  },
  {
    degree: "Specialization in Digital Signal Processing",
    institution: "Military Institute of Engineering (IME)",
    years: "1995–1996",
    crest: "/images/education/ime.png",
    alt: "Military Institute of Engineering coat of arms",
    category: "Signal Processing",
  },
  {
    degree: "Bachelor's Degree in Electrical Engineering",
    institution: "Federal University of Bahia (UFBA)",
    years: "1989–1993",
    crest: "/images/education/ufba.png",
    alt: "Federal University of Bahia coat of arms",
    category: "Electrical Engineering",
  },
];
---

<BaseLayout
  title="Certifications & Education | Peter Morris"
  description="Professional certifications, academic education and continuous professional development of Peter Morris."
>
  <main class="credentials-page">
    <section class="page-intro" aria-labelledby="page-title">
      <div class="container intro-layout">
        <div class="intro-copy">
          <p class="section-kicker">Credentials & learning</p>
          <h1 id="page-title">Certifications & Education</h1>
          <p class="page-lead">Continuous learning for greater impact</p>
          <p class="page-summary">Combining a strong foundation in electrical engineering with professional certifications and continuous development in leadership, project management, and emerging technologies.</p>
        </div>
      </div>
    </section>

    <section class="section-block certifications-section" aria-labelledby="certifications-heading">
      <div class="container">
        <h2 id="certifications-heading">Professional Certifications &amp; Development</h2>
        <div class="certification-grid">
          {certifications.map((certification) => (
            <article class="certification-card">
              <div class="certification-top">
                <img class="badge" src={certification.badge} alt={`${certification.abbreviation} certification badge`} width="88" height="88" loading="lazy" />
                <div class="certification-copy">
                  <p class="credential-short">{certification.abbreviation}</p>
                  <h3>{certification.name}</h3>
                  <p class="institution">{certification.issuer}</p>
                  <p class="meta">{certification.date}</p>
                  <a class="verify-link" href={certification.url} target="_blank" rel="noopener noreferrer" aria-label={`Verify ${certification.abbreviation} credential on Credly (opens in a new tab)`}>Verify Credential <span aria-hidden="true">↗</span></a>
                </div>
              </div>
              <p class="category-tag">{certification.category}</p>
            </article>
          ))}
          <article class="certification-card development-card" aria-label="Professional Development: 15 credentials and 170 plus hours in the last two years">
            <div class="development-stats">
              <div class="stat">
                <span class="stat-icon" aria-hidden="true">▤</span>
                <strong>15</strong>
                <span>Professional Development Credentials</span>
              </div>
              <div class="stat">
                <span class="stat-icon" aria-hidden="true">◷</span>
                <strong>170+</strong>
                <span>Hours of Professional Development</span>
              </div>
            </div>
            <p class="category-tag">Professional Development</p>
          </article>
        </div>
      </div>
    </section>

    <section class="topics-section" aria-labelledby="topics-heading">
      <div class="container topics-panel">
        <div class="topics-intro">
          <span class="topics-intro-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M3 20h18M5 17v-5h3v5M11 17V8h3v9M17 17V4h3v13"/></svg></span>
          <div>
            <h2 id="topics-heading">Continuous Professional Development</h2>
            <p>Key areas of development <span class="topics-period">· Last 2 years</span></p>
            <a class="development-link topics-credly-link" href="https://www.credly.com/users/morrisgpeter/badges/credly" target="_blank" rel="noopener noreferrer" aria-label="View all credentials on Credly (opens in a new tab)">View All Credentials <span aria-hidden="true">↗</span></a>
          </div>
        </div>
        <ul class="topics-list" aria-label="Professional development focus areas">
          <li><span class="topic-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><circle cx="8" cy="8" r="3"/><circle cx="17" cy="9" r="2.5"/><path d="M2.5 20v-2a5.5 5.5 0 0 1 11 0v2M14.5 15a4.5 4.5 0 0 1 7 3.7V20"/></svg></span><span>Leadership</span></li>
          <li><span class="topic-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><rect x="2" y="3" width="20" height="18" rx="2"/><path d="M7 8h3M7 13h3M7 18h3M14 8h5M14 13h5M14 18h5"/></svg></span><span>Project<br />Management</span></li>
          <li><span class="topic-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M20 7a8 8 0 0 0-14-2L3 8m0-5v5h5M4 17a8 8 0 0 0 14 2l3-3m0 5v-5h-5"/></svg></span><span>Agile</span></li>
          <li><span class="topic-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><rect x="6" y="6" width="12" height="12" rx="2"/><path d="M9 9h6v6H9zM9 2v4M15 2v4M9 18v4M15 18v4M2 9h4M2 15h4M18 9h4M18 15h4"/></svg></span><span>AI</span></li>
          <li><span class="topic-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M20 4c-9 0-15 4-15 11a5 5 0 0 0 5 5c7 0 11-6 10-16ZM4 21c3-6 7-10 13-13"/></svg></span><span>Sustainability</span></li>
          <li><span class="topic-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M3 20h18M5 17v-5h3v5M11 17V8h3v9M17 17V4h3v13M4 9l6-4 4 2 6-5"/></svg></span><span>Business<br />Transformation</span></li>
        </ul>
      </div>
    </section>
    <section class="section-block education-section" aria-labelledby="education-heading">
      <div class="container">
        <h2 id="education-heading">Academic Education</h2>
        <div class="education-grid">
          {education.map((item) => (
            <article class="education-card">
              <div class="education-top">
                <div class="crest-frame"><img src={item.crest} alt={item.alt} loading="lazy" /></div>
                <div class="education-copy">
                  <h3>{item.degree}</h3>
                  <p class="institution">{item.institution}</p>
                  <p class="meta">Brazil · {item.years}</p>
                </div>
              </div>
              <p class="category-tag">{item.category}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

  </main>
</BaseLayout>

<style>
  .credentials-page { background: #fff; color: #172b4d; }
  .page-intro { position: relative; overflow: hidden; }
  .intro-layout { display: grid; grid-template-columns: minmax(0, 1fr); gap: 0; align-items: center; padding-top: 35px; padding-bottom: 38px; }
  .intro-copy { position: relative; z-index: 1; }
  .section-kicker { color: #1b638f; text-transform: uppercase; font-size: 12px; font-weight: 700; letter-spacing: 2px; margin: 0 0 10px; }
  .page-intro h1 { color: #102b4a; font-size: clamp(32px, 3.5vw, 44px); line-height: 1.12; margin: 0 0 12px; }
  .page-lead { color: #195e91; font-size: clamp(20px, 2vw, 24px); font-weight: 700; margin: 0 0 10px; }
  .page-summary { max-width: 790px; color: #53677a; font-size: 16px; line-height: 1.5; margin: 0; }
  .section-block { padding: 31px 0; }
  .section-block h2 { font-size: clamp(23px, 2.5vw, 28px); margin: 0 0 18px; }
  .certifications-section { background: #f5f8fb; }
  .certification-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 16px; align-items: stretch; }
  .certification-card { min-width: 0; display: flex; flex-direction: column; justify-content: space-between; gap: 7px; padding: 14px 16px; border-radius: 10px; background: white; border: 1px solid #e2eaf1; box-shadow: 0 5px 18px rgba(9,31,58,.035); }
  .certification-top { display: flex; align-items: flex-start; gap: 12px; min-width: 0; }
  .badge { width: 72px; height: 72px; object-fit: contain; flex: 0 0 auto; }
  .certification-copy, .education-copy { min-width: 0; }
  .credential-short { font-size: 12px; font-weight: 800; letter-spacing: .04em; color: #21678f; margin: 0 0 4px; }
  .certification-card h3, .education-card h3 { font-size: 15px; line-height: 1.28; margin: 0 0 7px; }
  .institution { font-size: 13px; line-height: 1.4; margin: 0 0 7px; }
  .meta { color: #62778a; font-size: 12px; line-height: 1.4; margin: 0; }
  .verify-link { display: inline-block; margin-top: 11px; color: #135b8b; font-size: 13px; font-weight: 700; text-decoration: none; border-bottom: 1px solid currentColor; padding-bottom: 2px; }
  .verify-link:hover, .verify-link:focus-visible { color: #073758; }
  .category-tag { align-self: flex-end; width: fit-content; max-width: 100%; margin: 0; border-radius: 999px; padding: 6px 10px; background: #e9f3fb; color: #175d91; font-size: 11px; line-height: 1.2; }
  .development-card { background: #fff; justify-content: space-between; }
  .development-link { display: inline-block; align-self: flex-start; margin-top: 1px; color: #135b8b; font-size: 12px; font-weight: 700; text-decoration: none; border-bottom: 1px solid currentColor; padding-bottom: 2px; }
  .development-link:hover, .development-link:focus-visible { color: #073758; }
  .topics-credly-link { margin-top: 9px; }
  .development-stats { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); margin: auto 0; }
  .stat { min-width: 0; display: flex; flex-direction: column; align-items: center; text-align: center; gap: 5px; padding: 2px 8px; }
  .stat + .stat { border-left: 1px solid #d5e5f1; }
  .stat-icon { width: 32px; height: 32px; display: grid; place-items: center; border-radius: 50%; background: #e1f0fc; color: #155d94; font-size: 21px; }
  .stat strong { color: #123f65; font-size: clamp(30px,3.3vw,40px); line-height: 1; }
  .stat span:last-child { font-size: 11px; line-height: 1.35; }
  .education-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 16px; }
  .education-card { display: flex; flex-direction: column; justify-content: space-between; gap: 10px; background: #fff; border: 1px solid #e1e9f0; border-radius: 10px; padding: 17px; min-width: 0; }
  .education-top { display: flex; align-items: flex-start; gap: 12px; }
  .crest-frame { flex: 0 0 60px; display: flex; justify-content: center; }
  .crest-frame img { max-height: 70px; max-width: 60px; width: auto; height: auto; object-fit: contain; }
  .topics-section { padding: 0 0 30px; background: #f5f8fb; }
  .topics-panel { display: grid; grid-template-columns: minmax(225px, 1.15fr) minmax(0, 2fr); align-items: center; gap: 22px; background: #f1f7fb; border: 1px solid #dceaf5; border-radius: 12px; padding: 20px 22px; }
  .topics-intro { display: flex; align-items: center; gap: 13px; min-width: 0; }
  .topics-intro-icon { width: 53px; height: 53px; flex: 0 0 53px; display: grid; place-items: center; border-radius: 50%; background: #deedfb; color: #155d94; font-size: 30px; }
  .topics-intro h2 { color: #172b4d; font-size: 16px; line-height: 1.3; letter-spacing: 0; text-transform: none; margin: 0 0 6px; }
  .topics-intro p { color: #53677a; font-size: 12px; margin: 0; }
  .topics-period { white-space: nowrap; }
  .topics-list { display: grid; grid-template-columns: repeat(6, minmax(0, 1fr)); list-style: none; margin: 0; padding: 0; }
  .topics-list li { display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 7px; min-width: 0; min-height: 80px; padding: 3px 6px; border-left: 1px solid #d1e3f1; color: #172b4d; font-size: 11px; line-height: 1.3; text-align: center; }
  .topic-icon { color: #17659d; display: grid; place-items: center; width: 29px; height: 29px; }
  .topic-icon svg { width: 27px; height: 27px; }
  .topics-intro-icon svg { width: 30px; height: 30px; }
  @media (max-width: 1050px) { .certification-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } .development-card { grid-column: 1 / -1; } .education-grid { gap: 12px; } .education-top { flex-direction: column; } }
  @media (max-width: 1050px) { .topics-panel { grid-template-columns: 1fr; } .topics-list li:first-child { border-left: 0; } }
  @media (max-width: 700px) { .intro-layout { grid-template-columns: 1fr; gap: 14px; padding-top: 30px; padding-bottom: 28px; } .section-block { padding: 28px 0; } .certification-grid, .education-grid { grid-template-columns: 1fr; gap: 12px; } .development-card { grid-column: auto; } .certification-card { padding: 15px; } .badge { width: 64px; height: 64px; } .education-card { padding: 15px; } .education-top { flex-direction: row; } .crest-frame { flex-basis: 60px; } .topics-section { padding-bottom: 24px; } .topics-panel { padding: 18px 14px; gap: 16px; } .topics-list { grid-template-columns: repeat(3, minmax(0, 1fr)); row-gap: 12px; } .topics-list li:nth-child(3n+1) { border-left: 0; } .topics-list li { min-height: 72px; } }
  @media (max-width: 380px) { .certification-top { gap: 10px; } .badge { width: 56px; height: 56px; } .stat { padding: 4px; } .stat strong { font-size: 31px; } }
</style>
