---
import BaseLayout from "../layouts/BaseLayout.astro";

const certifications = [
  {
    abbreviation: "PMP®",
    name: "Project Management Professional",
    issuer: "Project Management Institute (PMI)",
    date: "Issued April 2025 · Valid through April 2028",
    badge: "/images/certifications/pmp.png",
    url: "https://www.credly.com/badges/40e3fb6d-937a-4479-a67f-bbd3026aa5bc",
  },
  {
    abbreviation: "PSM I",
    name: "Professional Scrum Master I",
    issuer: "Scrum.org",
    date: "Issued November 2025",
    badge: "/images/certifications/psm-i.png",
    url: "https://www.credly.com/badges/89bcaf52-15e6-4ad1-99d8-1ee939d0bb67",
  },
];

const education = [
  {
    degree: "Postgraduate Studies in Data Science & Big Data",
    institution: "Federal University of Bahia (UFBA)",
    years: "2021–2023",
    crest: "/images/education/ufba.png",
    alt: "Federal University of Bahia coat of arms",
  },
  {
    degree: "Specialization in Digital Signal Processing",
    institution: "Military Institute of Engineering (IME)",
    years: "1995–1996",
    crest: "/images/education/ime.png",
    alt: "Military Institute of Engineering coat of arms",
  },
  {
    degree: "Bachelor's Degree in Electrical Engineering",
    institution: "Federal University of Bahia (UFBA)",
    years: "1989–1993",
    crest: "/images/education/ufba.png",
    alt: "Federal University of Bahia coat of arms",
  },
];
---

<BaseLayout
  title="Certifications & Education | Peter Morris"
  description="Professional certifications, academic education and continuous professional development of Peter Morris."
>
  <main class="credentials-page">
    <section class="page-intro container" aria-labelledby="page-title">
      <p class="section-kicker">Credentials & learning</p>
      <h1 id="page-title">Certifications & Education</h1>
      <p class="page-lead">Continuous learning for greater impact</p>
      <p class="page-summary">Combining a strong foundation in electrical engineering with professional certifications and continuous development in leadership, project management, and emerging technologies.</p>
    </section>

    <section class="section-block certifications-section" aria-labelledby="certifications-heading">
      <div class="container">
        <h2 id="certifications-heading">Professional Certifications</h2>
        <div class="certification-grid">
          {certifications.map((certification) => (
            <article class="certification-card">
              <img class="badge" src={certification.badge} alt={`${certification.abbreviation} certification badge`} width="118" height="118" loading="lazy" />
              <div class="certification-copy">
                <p class="credential-short">{certification.abbreviation}</p>
                <h3>{certification.name}</h3>
                <p class="institution">{certification.issuer}</p>
                <p class="meta">{certification.date}</p>
                <a class="verify-link" href={certification.url} target="_blank" rel="noopener noreferrer" aria-label={`Verify ${certification.abbreviation} credential on Credly (opens in a new tab)`}>Verify Credential <span aria-hidden="true">↗</span></a>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="section-block education-section" aria-labelledby="education-heading">
      <div class="container">
        <h2 id="education-heading">Academic Education</h2>
        <div class="education-grid">
          {education.map((item) => (
            <article class="education-card">
              <div class="crest-frame"><img src={item.crest} alt={item.alt} loading="lazy" /></div>
              <div>
                <h3>{item.degree}</h3>
                <p class="institution">{item.institution}</p>
                <p class="meta">Brazil · {item.years}</p>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="section-block development-section" aria-labelledby="development-heading">
      <div class="container development-panel">
        <h2 id="development-heading">Continuous Professional Development</h2>
        <p class="development-count">15</p>
        <p class="development-label">Professional Development Credentials</p>
        <p class="development-topics">Leadership <span>·</span> Project Management <span>·</span> Agile <span>·</span> AI <span>·</span> Sustainability <span>·</span> Business Transformation</p>
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  .credentials-page { background: #fff; color: #172b4d; }
  .page-intro { padding-top: 38px; padding-bottom: 40px; }
  .section-kicker { color: #1b638f; text-transform: uppercase; font-size: 12px; font-weight: 700; letter-spacing: 2px; margin: 0 0 10px; }
  .page-intro h1 { color: #102b4a; font-size: clamp(32px, 3.5vw, 44px); line-height: 1.12; margin: 0 0 12px; }
  .page-lead { font-size: clamp(20px, 2vw, 24px); font-weight: 600; margin: 0 0 10px; }
  .page-summary { max-width: 790px; color: #53677a; font-size: 17px; line-height: 1.5; margin: 0; }
  .section-block { padding: 38px 0; }
  .section-block h2 { font-size: clamp(25px, 2.5vw, 30px); margin: 0 0 20px; }
  .certifications-section { background: #f5f8fb; }
  .certification-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 24px; }
  .certification-card { display: flex; align-items: flex-start; gap: 18px; padding: 22px; border-radius: 12px; background: white; border: 1px solid #e2eaf1; box-shadow: 0 8px 26px rgba(9, 31, 58, .04); }
  .badge { width: 88px; height: 88px; object-fit: contain; flex: 0 0 auto; }
  .certification-copy { min-width: 0; }
  .credential-short { font-size: 13px; font-weight: 800; letter-spacing: .06em; color: #21678f; margin: 0 0 7px; }
  .certification-card h3, .education-card h3 { font-size: 18px; line-height: 1.3; margin: 0 0 8px; }
  .institution { font-size: 15px; line-height: 1.5; margin: 0 0 8px; }
  .meta { color: #62778a; font-size: 14px; line-height: 1.5; margin: 0; }
  .verify-link { display: inline-block; margin-top: 12px; color: #135b8b; font-weight: 700; text-decoration: none; border-bottom: 1px solid currentColor; padding-bottom: 3px; }
  .verify-link:hover, .verify-link:focus-visible { color: #073758; }
  .education-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 24px; }
  .education-card { background: #fff; border: 1px solid #e1e9f0; border-radius: 12px; padding: 20px; min-width: 0; }
  .crest-frame { height: 76px; display: flex; align-items: center; justify-content: flex-start; margin-bottom: 12px; }
  .crest-frame img { max-height: 76px; max-width: 76px; width: auto; height: auto; object-fit: contain; }
  .development-section { background: #f5f8fb; }
  .development-panel { text-align: center; }
  .development-panel h2 { margin-bottom: 10px; }
  .development-count { color: #123f65; font-size: clamp(60px, 8vw, 80px); line-height: 1; font-weight: 800; margin: 0 0 10px; }
  .development-label { font-size: clamp(18px, 2vw, 22px); font-weight: 700; margin: 0 0 24px; }
  .development-topics { max-width: 850px; margin: 0 auto; color: #53677a; line-height: 1.6; font-size: 15px; }
  .development-topics span { color: #2a719a; padding: 0 7px; }
  @media (max-width: 900px) { .certification-grid { grid-template-columns: 1fr; } .education-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 600px) { .page-intro { padding-top: 32px; padding-bottom: 32px; } .section-block { padding: 36px 0; } .certification-card { flex-direction: column; padding: 25px; gap: 14px; } .badge { width: 100px; height: 100px; } .education-grid { grid-template-columns: 1fr; } .education-card { padding: 24px; } .development-topics span { padding: 0 3px; } }
</style>
