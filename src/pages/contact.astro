---
import BaseLayout from "../layouts/BaseLayout.astro";

const portrait = "/images/hero-portrait-transparent.png";
const channels = [
  { name: "Email", detail: "", href: "mailto:morrisgpeter@hotmail.com", icon: "email" },
  { name: "LinkedIn", detail: "", href: "https://www.linkedin.com/in/morrisgpeter/", icon: "linkedin" },
  { name: "Portfolio", detail: "", href: "https://github.com/morrisgpeter", icon: "github" },
];
---

<BaseLayout title="Contact | Peter Morris" description="Connect with Peter Morris about project and program management, commercial leadership, business development, sales, and critical infrastructure.">
  <main class="contact-page">
    <section class="intro" aria-labelledby="page-title">
      <div class="container intro-grid">
        <div class="intro-copy">
          <p class="kicker">Contact Channels</p>
          <h1 id="page-title">Get in Touch</h1>
          <p class="lead">Great opportunities begin with meaningful conversations.</p>
          <p>I'm open to discussing opportunities and ideas related to project and program management, commercial leadership, business development and sales, and critical infrastructure.</p>
          <p>Always open to connecting with professionals and organizations worldwide.</p>
        </div>
        <div class="portrait-frame"><img src={portrait} alt="Portrait of Peter Morris" width="190" height="190" loading="eager" /></div>
      </div>
    </section>

    <section class="reach-section" aria-label="Contact links and location">
      <div class="container">
        <div class="channel-grid">
          {channels.map((channel) => (
            <div class="channel">
              <span class="icon" aria-hidden="true">
                {channel.icon === "email" && <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 7 9 7 9-7"/></svg>}
                {channel.icon === "linkedin" && <svg viewBox="0 0 24 24" fill="currentColor"><path d="M5.2 3a2.2 2.2 0 1 0 0 4.4 2.2 2.2 0 0 0 0-4.4ZM3.4 9h3.6v12H3.4V9Zm5.8 0h3.5v1.6h.1a3.9 3.9 0 0 1 3.5-1.9c3.7 0 4.4 2.4 4.4 5.5V21h-3.6v-6c0-1.4 0-3.2-2-3.2s-2.3 1.5-2.3 3.1V21H9.2V9Z"/></svg>}
                {channel.icon === "github" && <svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 2a10 10 0 0 0-3.16 19.49c.5.09.68-.22.68-.48v-1.7c-2.78.6-3.37-1.18-3.37-1.18-.45-1.15-1.1-1.46-1.1-1.46-.91-.62.07-.61.07-.61 1 .07 1.52 1.03 1.52 1.03.89 1.52 2.34 1.08 2.91.82.09-.64.35-1.08.64-1.33-2.22-.25-4.56-1.11-4.56-4.94 0-1.09.39-1.98 1.03-2.68-.1-.25-.45-1.27.1-2.65 0 0 .84-.27 2.75 1.02A9.6 9.6 0 0 1 12 6.9c.85 0 1.7.11 2.5.34 1.91-1.29 2.75-1.02 2.75-1.02.55 1.38.2 2.4.1 2.65.64.7 1.03 1.59 1.03 2.68 0 3.84-2.34 4.69-4.57 4.94.36.31.68.92.68 1.85v2.67c0 .26.18.58.69.48A10 10 0 0 0 12 2Z"/></svg>}
              </span>
              <div class="channel-text">
                <h3><a href={channel.href} target={channel.icon === "email" ? undefined : "_blank"} rel={channel.icon === "email" ? undefined : "noopener noreferrer"} aria-label={`${channel.name}${channel.icon === "email" ? "" : " (opens in a new tab)"}`}>{channel.name}</a></h3>
                {channel.detail && <span class="channel-detail">{channel.detail}</span>}
              </div>
            </div>
          ))}
        </div>
        <div class="mobility">
          <span class="icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="M20 10c0 5-8 12-8 12S4 15 4 10a8 8 0 1 1 16 0Z"/><circle cx="12" cy="10" r="2.5"/></svg></span>
          <span class="mobility-content"><span class="mobility-heading">Location &amp; Mobility</span><span class="mobility-line"><strong>New Zealand</strong><span class="mobility-divider" aria-hidden="true"></span><span>Open to international opportunities.</span></span></span>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  .contact-page{background:#fff;color:#172b4d}
  .intro{padding:27px 0 23px}
  .intro-grid{display:grid;grid-template-columns:minmax(0,1fr) 190px;gap:36px;align-items:center}
  .kicker{margin:0 0 10px;color:#195e91;text-transform:uppercase;font-size:12px;font-weight:750;letter-spacing:2px}
  .intro h1{color:#102b4a;font-size:clamp(34px,3.7vw,44px);line-height:1.1;margin:0 0 9px}
  .intro-copy>p:not(.kicker){max-width:900px;margin:0 0 9px;color:#53677a;font-size:15px;line-height:1.55}
  .intro-copy .lead{color:#195e91!important;font-size:clamp(18px,2vw,22px)!important;font-weight:700;line-height:1.35!important}
  .intro-copy>p:last-child{margin-bottom:0}
  .portrait-frame{width:190px;aspect-ratio:1;border-radius:10px;overflow:hidden;background:#eaf2f8;box-shadow:0 6px 20px rgba(9,31,58,.08)}
  .portrait-frame img{display:block;width:100%;height:100%;object-fit:cover}
  .reach-section{background:#f1f7fb;padding:21px 0 19px}
  .reach-section h2{margin-bottom:13px}
  .channel-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:0}
  .channel{min-width:0;display:flex;align-items:center;gap:16px;padding:4px 24px 13px}
  .channel:first-child{padding-left:0}
  .channel+.channel{border-left:1px solid #c9d8e6}
  .icon{flex:0 0 54px;width:54px;height:54px;display:grid;place-items:center;border-radius:50%;background:#e1eef9;color:#155d94}
  .icon svg{width:27px;height:27px}
  .channel h3{color:#102b4a;font-size:19px;margin:0 0 4px}
  .channel h3 a{color:#1164a3;font-size:19px;font-weight:700;text-decoration:none}
  .channel-detail{color:#53677a;font-size:14px;overflow-wrap:anywhere}
  .channel a:hover,.channel a:focus-visible{text-decoration:underline;text-underline-offset:4px}
  .mobility{display:flex;align-items:center;gap:19px;border-top:1px solid #c9d8e6;padding-top:12px;color:#53677a;font-size:15px}
  .mobility-content{display:flex;flex-direction:column;gap:5px}
  .mobility-heading{color:#195e91;text-transform:uppercase;font-size:11px;font-weight:750;letter-spacing:1.2px}
  .mobility-line{display:flex;align-items:center;gap:19px}
  .mobility .icon{flex-basis:45px;width:45px;height:45px}
  .mobility .icon svg{width:24px;height:24px}
  .mobility strong{color:#102b4a;font-size:18px;white-space:nowrap}
  .mobility-divider{height:25px;border-left:1px solid #b9c9d9}
  @media(max-width:850px){.intro-grid{grid-template-columns:minmax(0,1fr) 155px;gap:24px}.portrait-frame{width:155px}.channel{gap:10px;padding-right:12px;padding-left:12px}.icon{flex-basis:45px;width:45px;height:45px}.channel h3 a{font-size:17px}}
  @media(max-width:650px){.intro{padding:28px 0}.intro-grid{grid-template-columns:1fr;gap:18px}.portrait-frame{grid-row:1;width:130px}.reach-section{padding:26px 0}.channel-grid{grid-template-columns:1fr}.channel,.channel:first-child{padding:12px 0}.channel+.channel{border-left:0;border-top:1px solid #d4e0ea}.mobility{gap:12px;padding-top:18px}.mobility-line{flex-wrap:wrap;gap:6px 12px}.mobility-divider{height:19px}}
</style>
