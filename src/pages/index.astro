---
const pageTitle = "Peter Morris | Professional Portfolio";

const heroTitle = "From Customer Needs to Business Value";

const heroSubtitle =
  "Understanding customer challenges, shaping the right solutions and leading their delivery to create measurable value and lasting relationships.";
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />

    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0"
    />

    <meta name="generator" content={Astro.generator} />

    <meta
      name="description"
      content="Peter Morris — Commercial Leadership and Project & Program Management."
    />

    <title>{pageTitle}</title>
  </head>

  <body>

    <!-- HEADER -->

    <header class="site-header">
      <div class="container header-content">

        <a href="/" class="logo">Peter Morris</a>

        <nav aria-label="Main navigation">
          <a href="#expertise">Expertise</a>
          <a href="#about">About</a>
          <a href="#contact">Contact</a>
        </nav>

      </div>
    </header>

    <!-- MAIN CONTENT -->

    <main>

      <!-- HERO -->

      <section class="hero">
        <div class="container hero-content">

          <div class="hero-text">

            <p class="eyebrow">
              COMMERCIAL LEADERSHIP · PROJECT & PROGRAM MANAGEMENT
            </p>

            <h1>{heroTitle}</h1>

            <p class="hero-subtitle">
              {heroSubtitle}
            </p>

            <a href="#expertise" class="hero-button">
              Explore My Expertise
            </a>

          </div>

          <div class="hero-image">
            <img
              src="/images/hero-portrait-transparent.png"
              alt="Peter Morris"
              width="1536"
              height="1024"
            />
          </div>

        </div>
      </section>

      <!-- AREAS OF EXPERTISE -->

      <section id="expertise" class="expertise">

        <div class="container">

          <h2>Areas of Expertise</h2>

          <div class="expertise-grid">

            <article class="expertise-card">

              <h3>Commercial Leadership</h3>

              <p>
                Connecting customer needs with business opportunities,
                developing solutions and building lasting relationships.
              </p>

            </article>

            <article class="expertise-card">

              <h3>Project & Program Management</h3>

              <p>
                Leading complex projects and multidisciplinary teams
                to deliver measurable business outcomes.
              </p>

            </article>

          </div>

        </div>

      </section>

    </main>

    <style>

      /* ========================================
         GLOBAL
      ======================================== */

      :global(*) {
        box-sizing: border-box;
      }

      :global(html) {
        scroll-behavior: smooth;
      }

      :global(body) {
        margin: 0;
        font-family: Arial, Helvetica, sans-serif;
        color: #172b4d;
      }

      .container {
        width: min(1200px, 90%);
        margin: 0 auto;
      }


      /* ========================================
         HEADER
      ======================================== */

      .site-header {
        background: #071a33;
        padding: 24px 0;
      }

      .header-content {
        display: flex;
        justify-content: space-between;
        align-items: center;
      }

      .logo {
        color: white;
        font-size: 22px;
        font-weight: 700;
        text-decoration: none;
      }

      nav {
        display: flex;
        gap: 32px;
      }

      nav a {
        color: #d8e4f0;
        text-decoration: none;
        font-size: 15px;
        transition: color 0.2s ease;
      }

      nav a:hover {
        color: white;
      }


      /* ========================================
         HERO
      ======================================== */

      .hero {
        background: linear-gradient(
          120deg,
          #071a33 0%,
          #10365c 55%,
          #1a5276 100%
        );

        color: white;
        min-height: 650px;

        display: flex;
        align-items: stretch;

        position: relative;
        overflow: hidden;
      }

      .hero-content {
        display: grid;

        grid-template-columns: 1.2fr 1fr;

        align-items: center;

        gap: 60px;
      }


      /* HERO TEXT */

      .hero-text {
        position: relative;
        z-index: 2;
        padding: 70px 0;
      }

      .eyebrow {
        font-size: 13px;
        letter-spacing: 2px;
        color: #8fc8e8;
        margin-bottom: 25px;
      }

      h1 {
        font-size: clamp(42px, 5vw, 68px);
        line-height: 1.1;
        margin: 0 0 30px;
        font-weight: 700;
      }

      .hero-subtitle {
        font-size: 19px;
        line-height: 1.7;
        color: #d7e5f2;

        max-width: 600px;
        margin-bottom: 35px;
      }

      .hero-button {
        display: inline-block;

        background: #ffffff;
        color: #10365c;

        padding: 15px 28px;

        border-radius: 6px;

        font-weight: 600;
        text-decoration: none;

        transition: transform 0.2s ease;
      }

      .hero-button:hover {
        transform: translateY(-3px);
      }


      /* HERO IMAGE */

      .hero-image {
        display: flex;

        justify-content: center;
        align-items: flex-end;

        align-self: stretch;

        position: relative;
      }

      .hero-image img {
        width: 130%;
        max-width: 630px;

        height: auto;

        display: block;

        object-fit: contain;

        align-self: flex-end;
      }


      /* ========================================
         AREAS OF EXPERTISE
      ======================================== */

      .expertise {
        padding: 100px 0;
        background: #f5f8fb;
      }

      .expertise h2 {
        font-size: 36px;
        margin: 0 0 45px;
      }

      .expertise-grid {
        display: grid;

        grid-template-columns: repeat(2, 1fr);

        gap: 30px;
      }

      .expertise-card {
        background: white;

        padding: 40px;

        border-radius: 10px;

        box-shadow: 0 8px 30px rgba(0, 0, 0, 0.05);
      }

      .expertise-card h3 {
        font-size: 24px;
        margin-top: 0;
      }

      .expertise-card p {
        font-size: 17px;
        line-height: 1.7;
        color: #526477;
      }


      /* ========================================
         RESPONSIVE — TABLET & MOBILE
      ======================================== */

      @media (max-width: 800px) {

        .header-content {
          flex-direction: column;
          gap: 20px;
        }

        nav {
          gap: 20px;
        }

        .hero {
          min-height: auto;
        }

        .hero-content {
          grid-template-columns: 1fr;
          text-align: center;
          gap: 0;
        }

        .hero-text {
          padding: 50px 0 10px;
        }

        h1 {
          font-size: clamp(36px, 7vw, 52px);
        }

        .hero-subtitle {
          margin-left: auto;
          margin-right: auto;
        }

        .hero-image {
          justify-content: center;
          align-self: auto;
		  margin-top: 10px;
        }

        .hero-image img {
          width: 100%;
          max-width: 400px;
        }

        .expertise-grid {
          grid-template-columns: 1fr;
        }

        .expertise {
          padding: 70px 0;
        }

      }


      /* ========================================
         RESPONSIVE — SMALL PHONES
      ======================================== */

      @media (max-width: 480px) {

        .logo {
          font-size: 20px;
        }

        nav {
          gap: 16px;
        }

        nav a {
          font-size: 14px;
        }

        .eyebrow {
          font-size: 11px;
          letter-spacing: 1.5px;
        }

        h1 {
          font-size: 36px;
        }

        .hero-subtitle {
          font-size: 16px;
          line-height: 1.6;
        }

        .hero-button {
          padding: 14px 22px;
        }

        .expertise h2 {
          font-size: 30px;
        }

        .expertise-card {
          padding: 28px;
        }

        .expertise-card h3 {
          font-size: 22px;
        }

      }

    </style>

  </body>
</html>