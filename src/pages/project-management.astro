---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectManagementHero from '../components/expertise/ProjectManagementHero.astro';
import ProjectManagementApproaches from '../components/expertise/ProjectManagementApproaches.astro';
import ProjectManagementScopeEvolution from '../components/expertise/ProjectManagementScopeEvolution.astro';
import ProjectManagementLeadership_Combined from '../components/expertise/ProjectManagementLeadership_Combined.astro';
---

<BaseLayout
  title="Project & Program Management | Peter Morris"
  description="Project and program management expertise in complex delivery, stakeholder leadership, risk and opportunity management, and governance."
>
  <main id="main-content" class="project-management-page">
    <ProjectManagementHero />

    <div class="management-overview">
      <div class="management-overview__grid">
        <div class="management-overview__item"><ProjectManagementApproaches /></div>
        <div class="management-overview__item"><ProjectManagementScopeEvolution /></div>
      </div>
    </div>

    <ProjectManagementLeadership_Combined />
  </main>
</BaseLayout>

<style>
  .management-overview { background: #f4f8fc; padding: 28px 0; }
  .management-overview__grid { width: min(1440px, 94%); margin: 0 auto; display: grid; grid-template-columns: minmax(0, 1fr); gap: 24px; }
  .management-overview__item { min-width: 0; }

  @media (min-width: 1100px) {
    .management-overview__grid { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); align-items: start; }
    .management-overview__item { background: #fff; border: 1px solid #dce8f3; border-radius: 20px; overflow: hidden; }
    .management-overview__item :global(.pm-approaches),
    .management-overview__item :global(.scope) { box-sizing: border-box; background: transparent; padding: 20px 22px; }
    .management-overview__item :global(.pm-approaches__inner) { width: 100%; max-width: none; }
    .management-overview__item :global(.pm-approaches__inner > *) { max-width: none; }
    .management-overview__item :global(.scope__container) { max-width: none; }
    .management-overview__item :global(.scope__chart) { padding: 12px 12px; box-shadow: none; }
    .management-overview__item :global(.pm-approaches h2),
    .management-overview__item :global(.scope h2) { font-size: 29px; line-height: 1.2; margin-bottom: 6px; }
    .management-overview__item :global(.scope__lead) { min-height: 0; margin-bottom: 12px; font-size: 14px; }
    .management-overview__item :global(.scope__eyebrow) { font-size: 11px; letter-spacing: .15em; font-weight: 700; }
    .management-overview__item :global(.scope__note) { font-size: 11px; }
    .management-overview__item :global(.scope__legend) { justify-content: flex-start; gap: 8px 13px; margin-bottom: 12px; }
    .management-overview__item :global(.scope__legend-item) { font-size: 11px; gap: 5px; }
    .management-overview__item :global(.scope__row) { grid-template-columns: 60px minmax(0,1fr); gap: 9px; }
    .management-overview__item :global(.scope__logo img) { max-width: 56px; height: 26px; }
    .management-overview__item :global(.scope__bar) { height: 23px; }
    .management-overview__item :global(.scope__rows) { gap: 9px; }

  }
  @media (max-width: 1099px) {
    .management-overview__grid { width: 100%; gap: 0; }
  }
</style>
